// LEADRO schema: Phase 1 foundation + Phase 2 operational core. See docs/ERD.md and docs/DECISIONS.md.
//
// Conventions
// - Every tenant-owned table has a non-null "tenantId" (FK to Tenant) and is protected by a
//   FORCE row-level-security policy (see the hand-written rls migration).
// - Every tenant-owned table has @@unique([id, tenantId]) so child rows can reference parents with
//   a COMPOSITE foreign key (parentId, tenantId). The database therefore rejects a row that points
//   at a parent of another tenant (FK checks are not subject to RLS).
// - Timestamps are timestamptz (UTC). Internal enums are language-neutral English identifiers.
// - Locale columns are plain strings constrained by CHECK to en-US | es-US | he-IL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Enums ─────────────────────────

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum OrgUnitType {
  BUSINESS_UNIT
  STATE
  REGION
  CITY
  BRANCH
  DEPARTMENT
  TEAM
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
}

enum AssignmentKind {
  PRIMARY
  SECONDARY
  TEMPORARY
}

enum UserStatus {
  INVITED
  ACTIVE
  LOCKED
  DEACTIVATED
}

enum PermissionAction {
  VIEW
  CREATE
  EDIT
  ARCHIVE
  ASSIGN
  APPROVE
  REJECT
  EXPORT
  MANAGE
  CONFIGURE
}

enum ScopeType {
  TENANT
  LEGAL_ENTITY
  ORG_UNIT
  OWN
  ASSIGNED
}

enum AuthEventType {
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  LOGOUT
  SESSION_REVOKED
  ACCOUNT_LOCKED
  ACCOUNT_UNLOCKED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  PASSWORD_CHANGED
  INVITATION_ACCEPTED
  MFA_CHALLENGE_SUCCEEDED
  MFA_CHALLENGE_FAILED
}

enum AuditActorType {
  USER
  SYSTEM
}

enum AuditOutcome {
  SUCCESS
  DENIED
  FAILED
}

enum SourceApp {
  WEB
  MOBILE
  API
  SYSTEM
}

// ───────────────────────── Organization ─────────────────────────

/// A customer company. Not RLS-protected: it is resolved by slug (company code) at login.
/// Only non-sensitive identity and locale defaults live here.
model Tenant {
  id              String       @id @default(cuid())
  slug            String       @unique
  name            String
  status          TenantStatus @default(ACTIVE)
  defaultLocale   String       @default("en-US")
  defaultTimeZone String       @default("America/New_York")
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(3)

  legalEntities   LegalEntity[]
  orgUnits        OrgUnit[]
  orgUnitManagers OrgUnitManager[]
  users           User[]
  employees       Employee[]
  assignments     OrganizationalAssignment[]
  roles           Role[]
  rolePermissions RolePermission[]
  roleAssignments RoleAssignment[]
  accessScopes    AccessScope[]
  sessions        Session[]
  authEvents      AuthenticationEvent[]
  invitations     Invitation[]
  resetTokens     PasswordResetToken[]
  auditEvents     AuditEvent[]
  idempotency     IdempotencyRecord[]
  translations    TranslationResource[]

  // Phase 2 (operational core)
  numberSequences            NumberSequence[]
  operationsSettings         OperationsSettings?
  customers                  Customer[]
  customerAddresses          CustomerAddress[]
  customerNotes              CustomerNote[]
  leadSources                LeadSource[]
  leads                      Lead[]
  leadAssignments            LeadAssignment[]
  leadStatusHistory          LeadStatusHistory[]
  leadInteractions           LeadInteraction[]
  duplicateFlags             DuplicateFlag[]
  skills                     Skill[]
  certifications             Certification[]
  jobTypes                   JobType[]
  jobTypeSkills              JobTypeSkill[]
  jobTypeCertifications      JobTypeCertification[]
  jobs                       Job[]
  jobRequirements            JobRequirement[]
  jobAssignments             JobAssignment[]
  jobStatusHistory           JobStatusHistory[]
  jobEvents                  JobEvent[]
  dispatchRecommendations    DispatchRecommendation[]
  employeeQualifications     EmployeeQualification[]
  serviceTerritories         ServiceTerritory[]
  availabilities             Availability[]
  notifications              Notification[]
  notificationDeliveries     NotificationDelivery[]
  notificationPreferences    NotificationPreference[]
  employeeJobPermissions     EmployeeJobPermission[]
  customerPreferredEmployees CustomerPreferredEmployee[]
  // Phase 3
  shifts                     Shift[]
  locationEvents             LocationEvent[]
  arrivalVerifications       ArrivalVerification[]
  fieldEvents                FieldEvent[]
  completionFormDefinitions  JobCompletionFormDefinition[]
  jobCompletions             JobCompletion[]
  jobMaterialUsages          JobMaterialUsage[]
  jobFieldNotes              JobFieldNote[]
  jobAttachments             JobAttachment[]
  lostReasons                LostReason[]
  jobOutcomes                JobOutcome[]
  recoveryRules              RecoveryRule[]
  recoveryCases              LeadRecoveryCase[]
  recoveryCaseStatusHistory  RecoveryCaseStatusHistory[]
  recoveryAttempts           RecoveryAttempt[]
  followUpTasks              FollowUpTask[]
  recoveryRuleRuns           RecoveryRuleRun[]

  // Phase 4
  materials                Material[]
  materialCostVersions     MaterialCostVersion[]
  ledgerEntries            LedgerEntry[]
  payments                 Payment[]
  refunds                  Refund[]
  chargebacks              Chargeback[]
  adjustments              Adjustment[]
  approvalPolicies         ApprovalPolicy[]
  approvalRequests         ApprovalRequest[]
  approvalDecisions        ApprovalDecision[]
  reconciliationRuns       ReconciliationRun[]
  reconciliationExceptions ReconciliationException[]
  paymentIntakeEvents      PaymentIntakeEvent[]
}

model LegalEntity {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  legalName String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  orgUnits  OrgUnit[]
  employees Employee[]
  scopes    AccessScope[]

  ledgerEntries      LedgerEntry[]
  reconciliationRuns ReconciliationRun[]

  @@unique([id, tenantId])
  @@unique([tenantId, name])
  @@index([tenantId])
}

/// One table for the whole typed hierarchy (BUSINESS_UNIT, STATE, REGION, CITY, BRANCH,
/// DEPARTMENT, TEAM). Branch-only attributes are nullable and used when type = BRANCH.
model OrgUnit {
  id             String      @id @default(cuid())
  tenantId       String
  type           OrgUnitType
  name           String
  code           String?
  parentId       String?
  legalEntityId  String?
  active         Boolean     @default(true)
  // Branch attributes
  address        Json?
  timeZone       String?
  defaultLocale  String?
  operatingHours Json?
  /// Branch / depot coordinates: origin of straight-line distance estimates (range CHECKs in the fixes migration).
  latitude       Decimal?    @db.Decimal(9, 6)
  longitude      Decimal?    @db.Decimal(9, 6)
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(3)

  tenant      Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  parent      OrgUnit?                   @relation("OrgUnitTree", fields: [parentId, tenantId], references: [id, tenantId], onDelete: Restrict)
  children    OrgUnit[]                  @relation("OrgUnitTree")
  legalEntity LegalEntity?               @relation(fields: [legalEntityId, tenantId], references: [id, tenantId], onDelete: Restrict)
  managers    OrgUnitManager[]
  assignments OrganizationalAssignment[]
  scopes      AccessScope[]

  // Phase 2
  customers          Customer[]
  customerAddresses  CustomerAddress[]
  leads              Lead[]
  jobs               Job[]
  teamJobAssignments JobAssignment[]
  serviceTerritories ServiceTerritory[]

  // Phase 3
  shifts         Shift[]
  locationEvents LocationEvent[]
  recoveryRules  RecoveryRule[]
  recoveryCases  LeadRecoveryCase[]
  followUpTasks  FollowUpTask[]

  ledgerEntries    LedgerEntry[]     @relation("LedgerEntryOrgUnit")
  payments         Payment[]         @relation("PaymentOrgUnit")
  refunds          Refund[]          @relation("RefundOrgUnit")
  chargebacks      Chargeback[]      @relation("ChargebackOrgUnit")
  adjustments      Adjustment[]      @relation("AdjustmentOrgUnit")
  approvalRequests ApprovalRequest[] @relation("ApprovalRequestOrgUnit")

  @@unique([id, tenantId])
  @@index([tenantId, parentId])
  @@index([tenantId, type])
  @@index([tenantId, legalEntityId])
}

model Employee {
  id              String         @id @default(cuid())
  tenantId        String
  userId          String?
  /// The legal employer. Operational placement is expressed by OrganizationalAssignment instead.
  legalEntityId   String?
  employeeNumber  String?
  firstName       String
  lastName        String
  email           String?
  phone           String?
  jobTitle        String?
  status          EmployeeStatus @default(ACTIVE)
  hireDate        DateTime?      @db.Date
  terminationDate DateTime?      @db.Date
  /// Optional start location (home/depot): origin of straight-line distance estimates.
  startLatitude   Decimal?       @db.Decimal(9, 6)
  startLongitude  Decimal?       @db.Decimal(9, 6)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)

  tenant       Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user         User?                      @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: Restrict)
  legalEntity  LegalEntity?               @relation(fields: [legalEntityId, tenantId], references: [id, tenantId], onDelete: Restrict)
  assignments  OrganizationalAssignment[]
  managedUnits OrgUnitManager[]

  // Phase 2
  jobPermissions          EmployeeJobPermission[]
  customerPreferences     CustomerPreferredEmployee[]
  qualifications          EmployeeQualification[]
  serviceTerritories      ServiceTerritory[]
  availabilities          Availability[]
  leadAssignments         LeadAssignment[]
  jobAssignments          JobAssignment[]
  dispatchRecommendations DispatchRecommendation[]

  // Phase 3
  shifts                    Shift[]
  locationEvents            LocationEvent[]
  arrivalVerifications      ArrivalVerification[]
  fieldEvents               FieldEvent[]
  jobCompletions            JobCompletion[]
  jobMaterialUsages         JobMaterialUsage[]
  jobFieldNotes             JobFieldNote[]
  jobOutcomes               JobOutcome[]
  recoveryCasesAsTechnician LeadRecoveryCase[]    @relation("RecoveryCaseTechnician")
  recoveryCasesAssigned     LeadRecoveryCase[]    @relation("RecoveryCaseAssignee")
  recoveryAttempts          RecoveryAttempt[]     @relation("RecoveryAttemptEmployee")
  followUpsAssigned         FollowUpTask[]        @relation("FollowUpAssignee")

  @@unique([id, tenantId])
  @@unique([userId, tenantId])
  @@unique([tenantId, employeeNumber])
  @@index([tenantId, status])
  @@index([tenantId, legalEntityId])
}

/// Which employees manage an org unit (many-to-many, time-bounded).
model OrgUnitManager {
  id            String    @id @default(cuid())
  tenantId      String
  orgUnitId     String
  employeeId    String
  isPrimary     Boolean   @default(false)
  effectiveFrom DateTime  @default(now()) @db.Timestamptz(3)
  effectiveTo   DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  orgUnit  OrgUnit  @relation(fields: [orgUnitId, tenantId], references: [id, tenantId], onDelete: Restrict)
  employee Employee @relation(fields: [employeeId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@unique([orgUnitId, employeeId, effectiveFrom])
  @@index([tenantId, orgUnitId])
  @@index([tenantId, employeeId])
}

/// Employee placement in the org tree over time. Rows are never overwritten: a move closes the
/// current row (effectiveTo) and inserts a new one. This is the historical record reports use.
model OrganizationalAssignment {
  id            String         @id @default(cuid())
  tenantId      String
  employeeId    String
  orgUnitId     String
  kind          AssignmentKind @default(PRIMARY)
  effectiveFrom DateTime       @default(now()) @db.Timestamptz(3)
  effectiveTo   DateTime?      @db.Timestamptz(3)
  reason        String?
  createdById   String?
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee  Employee @relation(fields: [employeeId, tenantId], references: [id, tenantId], onDelete: Restrict)
  orgUnit   OrgUnit  @relation(fields: [orgUnitId, tenantId], references: [id, tenantId], onDelete: Restrict)
  createdBy User?    @relation("AssignmentCreatedBy", fields: [createdById, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@index([tenantId, employeeId, effectiveFrom])
  @@index([tenantId, orgUnitId])
}

// ───────────────────────── Identity and access ─────────────────────────

model User {
  id                 String     @id @default(cuid())
  tenantId           String
  /// Stored lower-cased (CHECK enforced). Unique per tenant, not globally.
  email              String
  passwordHash       String?
  status             UserStatus @default(INVITED)
  /// Nullable: falls back to org unit (branch) default, then tenant default.
  locale             String?
  timeZone           String?
  mfaEnabled         Boolean    @default(false)
  mfaSecretEncrypted String?
  /// Highest TOTP time step already accepted; a code for an older or equal step is a replay.
  mfaLastUsedStep    Int?
  failedLoginCount   Int        @default(0)
  lockedUntil        DateTime?  @db.Timestamptz(3)
  lastLoginAt        DateTime?  @db.Timestamptz(3)
  passwordChangedAt  DateTime?  @db.Timestamptz(3)
  createdAt          DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @db.Timestamptz(3)

  tenant               Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee             Employee?
  sessions             Session[]
  authEvents           AuthenticationEvent[]
  roleAssignments      RoleAssignment[]           @relation("AssignmentUser")
  grantedAssignments   RoleAssignment[]           @relation("AssignmentGrantedBy")
  revokedAssignments   RoleAssignment[]           @relation("AssignmentRevokedBy")
  resetTokens          PasswordResetToken[]
  invitationsSent      Invitation[]
  orgAssignmentsMade   OrganizationalAssignment[] @relation("AssignmentCreatedBy")
  translationsEdited   TranslationResource[]      @relation("TranslationEditedBy")
  translationsReviewed TranslationResource[]      @relation("TranslationReviewedBy")

  // Phase 2
  customersCreated        Customer[]               @relation("CustomerCreatedBy")
  customerNotesWritten    CustomerNote[]           @relation("CustomerNoteAuthor")
  leadsCreated            Lead[]                   @relation("LeadCreatedBy")
  leadAssignmentsMade     LeadAssignment[]         @relation("LeadAssignmentAssignedBy")
  leadStatusChanges       LeadStatusHistory[]      @relation("LeadStatusChangedBy")
  leadInteractionsWritten LeadInteraction[]        @relation("LeadInteractionAuthor")
  duplicatesResolved      DuplicateFlag[]          @relation("DuplicateFlagResolvedBy")
  jobsCreated             Job[]                    @relation("JobCreatedBy")
  jobAssignmentsMade      JobAssignment[]          @relation("JobAssignmentAssignedBy")
  jobStatusChanges        JobStatusHistory[]       @relation("JobStatusChangedBy")
  jobEventsRecorded       JobEvent[]               @relation("JobEventActor")
  dispatchRecsGenerated   DispatchRecommendation[] @relation("DispatchRecGeneratedBy")
  dispatchRecsDecided     DispatchRecommendation[] @relation("DispatchRecDecidedBy")
  qualificationsVerified  EmployeeQualification[]  @relation("QualificationVerifiedBy")
  notificationsReceived   Notification[]           @relation("NotificationRecipient")
  notificationPreferences NotificationPreference[]

  jobPermissionsGranted     EmployeeJobPermission[] @relation("JobPermissionGrantedBy")
  operationsSettingsUpdated OperationsSettings[]    @relation("OperationsSettingsUpdatedBy")

  // Phase 3
  shiftsEnded              Shift[]                       @relation("ShiftEndedBy")
  locationEventsRecorded   LocationEvent[]               @relation("LocationEventRecordedBy")
  arrivalsVerified         ArrivalVerification[]         @relation("ArrivalVerifiedBy")
  fieldEventsSent          FieldEvent[]                  @relation("FieldEventActor")
  formsPublished           JobCompletionFormDefinition[] @relation("FormDefinitionPublishedBy")
  formsCreated             JobCompletionFormDefinition[] @relation("FormDefinitionCreatedBy")
  completionsSubmitted     JobCompletion[]               @relation("JobCompletionSubmittedBy")
  attachmentsUploaded      JobAttachment[]               @relation("JobAttachmentUploadedBy")
  outcomesRecorded         JobOutcome[]                  @relation("JobOutcomeRecordedBy")
  recoveryRulesCreated     RecoveryRule[]                @relation("RecoveryRuleCreatedBy")
  recoveryRulesApproved    RecoveryRule[]                @relation("RecoveryRuleApprovedBy")
  recoveryCasesRecovered   LeadRecoveryCase[]            @relation("RecoveryCaseRecoveredBy")
  recoveryStatusChanges    RecoveryCaseStatusHistory[]   @relation("RecoveryStatusChangedBy")
  recoveryAttemptsRecorded RecoveryAttempt[]             @relation("RecoveryAttemptRecordedBy")
  followUpsCompleted       FollowUpTask[]                @relation("FollowUpCompletedBy")
  followUpsCreated         FollowUpTask[]                @relation("FollowUpCreatedBy")

  shiftsReviewed Shift[] @relation("ShiftReviewedBy")

  // Phase 4
  materialsCreated                 Material[]                @relation("MaterialCreatedBy")
  materialCostVersionsCreated      MaterialCostVersion[]     @relation("MaterialCostVersionCreatedBy")
  ledgerEntriesPosted              LedgerEntry[]             @relation("LedgerEntryActor")
  paymentsRecorded                 Payment[]                 @relation("PaymentRecordedBy")
  refundsRequested                 Refund[]                  @relation("RefundRequestedBy")
  chargebacksRecorded              Chargeback[]              @relation("ChargebackRecordedBy")
  adjustmentsRequested             Adjustment[]              @relation("AdjustmentRequestedBy")
  approvalPoliciesCreated          ApprovalPolicy[]          @relation("ApprovalPolicyCreatedBy")
  approvalRequestsRequested        ApprovalRequest[]         @relation("ApprovalRequestRequestedBy")
  approvalRequestsCancelled        ApprovalRequest[]         @relation("ApprovalRequestCancelledBy")
  approvalDecisionsMade            ApprovalDecision[]        @relation("ApprovalDecisionDecider")
  reconciliationRunsStarted        ReconciliationRun[]       @relation("ReconciliationRunStartedBy")
  reconciliationExceptionsAssigned ReconciliationException[] @relation("ReconciliationExceptionAssignedTo")
  reconciliationExceptionsResolved ReconciliationException[] @relation("ReconciliationExceptionResolvedBy")

  @@unique([id, tenantId])
  @@unique([tenantId, email])
  @@index([tenantId, status])
}

model Role {
  id               String   @id @default(cuid())
  tenantId         String
  name             String
  description      String?
  /// Template key this role was cloned from (e.g. "CEO"). Informational only: access is decided
  /// solely by granted permissions + scopes, never by name or key.
  templateKey      String?
  isSystemTemplate Boolean  @default(false)
  requiresMfa      Boolean  @default(false)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  permissions RolePermission[]
  assignments RoleAssignment[]

  @@unique([id, tenantId])
  @@unique([tenantId, name])
  @@index([tenantId])
}

/// Global permission catalog (module + action). Not tenant-owned, no RLS; written by seed only.
model Permission {
  id          String           @id @default(cuid())
  /// "<module>.<action>" in lower case, e.g. "jobs.view".
  key         String           @unique
  module      String
  action      PermissionAction
  description String?
  /// Sensitive permissions may require additional approval (spec 4.3).
  sensitive   Boolean          @default(false)

  rolePermissions RolePermission[]

  @@unique([module, action])
}

model RolePermission {
  tenantId     String
  roleId       String
  permissionId String
  /// Qualifiers for "Limited" grants from the 4.5 matrix, e.g. {"fields":"financial"}.
  conditions   Json?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  role       Role       @relation(fields: [roleId, tenantId], references: [id, tenantId], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([tenantId])
}

/// A user holds a role, optionally time-bounded (temporary access). Scopes decide which data.
model RoleAssignment {
  id            String    @id @default(cuid())
  tenantId      String
  userId        String
  roleId        String
  effectiveFrom DateTime  @default(now()) @db.Timestamptz(3)
  effectiveTo   DateTime? @db.Timestamptz(3)
  grantedById   String?
  reason        String?
  revokedAt     DateTime? @db.Timestamptz(3)
  revokedById   String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)

  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user      User          @relation("AssignmentUser", fields: [userId, tenantId], references: [id, tenantId], onDelete: Restrict)
  role      Role          @relation(fields: [roleId, tenantId], references: [id, tenantId], onDelete: Restrict)
  grantedBy User?         @relation("AssignmentGrantedBy", fields: [grantedById, tenantId], references: [id, tenantId], onDelete: Restrict)
  revokedBy User?         @relation("AssignmentRevokedBy", fields: [revokedById, tenantId], references: [id, tenantId], onDelete: Restrict)
  scopes    AccessScope[]

  @@unique([id, tenantId])
  @@index([tenantId, userId])
  @@index([tenantId, roleId])
}

/// Data scope of a role assignment. ORG_UNIT includes descendants when includeDescendants = true.
model AccessScope {
  id                 String    @id @default(cuid())
  tenantId           String
  roleAssignmentId   String
  type               ScopeType
  legalEntityId      String?
  orgUnitId          String?
  includeDescendants Boolean   @default(true)
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  roleAssignment RoleAssignment @relation(fields: [roleAssignmentId, tenantId], references: [id, tenantId], onDelete: Cascade)
  legalEntity    LegalEntity?   @relation(fields: [legalEntityId, tenantId], references: [id, tenantId], onDelete: Restrict)
  orgUnit        OrgUnit?       @relation(fields: [orgUnitId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@index([tenantId, roleAssignmentId])
}

model Session {
  id            String    @id @default(cuid())
  tenantId      String
  userId        String
  /// SHA-256 of the opaque token. The token itself is "<tenantId>.<random>" so the tenant is
  /// known before the RLS context is opened.
  tokenHash     String    @unique
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  lastSeenAt    DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt     DateTime  @db.Timestamptz(3)
  revokedAt     DateTime? @db.Timestamptz(3)
  ipAddress     String?
  userAgent     String?
  /// True between a correct password and a correct TOTP code. A pending session may only call the
  /// MFA endpoints; every other route rejects it.
  mfaPending    Boolean   @default(false)
  /// When this session passed an MFA challenge (set when a pending session is promoted). A full
  /// session without it is re-checked on every request: if the user has since been given a role that
  /// requires MFA, the session goes back to `mfaPending`.
  mfaVerifiedAt DateTime? @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([id, tenantId])
  @@index([tenantId, userId])
  @@index([expiresAt])
}

/// Login history (success, failure, lockout, reset, MFA).
model AuthenticationEvent {
  id             String        @id @default(cuid())
  tenantId       String
  userId         String?
  emailAttempted String?
  type           AuthEventType
  ipAddress      String?
  userAgent      String?
  correlationId  String?
  metadata       Json?
  occurredAt     DateTime      @default(now()) @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User?  @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@index([tenantId, userId, occurredAt])
  @@index([tenantId, type, occurredAt])
}

model Invitation {
  id                      String     @id @default(cuid())
  tenantId                String
  email                   String
  /// SHA-256 of the invitation token (token is "<tenantId>.<random>").
  tokenHash               String     @unique
  invitedById             String?
  roleId                  String?
  /// Data scope granted with `roleId` (required whenever roleId is set: a role without a scope
  /// grants nothing). Targets are validated in the service; no FK so OrgUnit/LegalEntity stay untouched.
  scopeType               ScopeType?
  scopeLegalEntityId      String?
  scopeOrgUnitId          String?
  scopeIncludeDescendants Boolean    @default(true)
  employeeId              String?
  expiresAt               DateTime   @db.Timestamptz(3)
  acceptedAt              DateTime?  @db.Timestamptz(3)
  revokedAt               DateTime?  @db.Timestamptz(3)
  createdAt               DateTime   @default(now()) @db.Timestamptz(3)

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invitedBy User?  @relation(fields: [invitedById, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@index([tenantId, email])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tenantId  String
  userId    String
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([id, tenantId])
  @@index([tenantId, userId])
}

// ───────────────────────── Platform ─────────────────────────

/// Append-only (DB trigger rejects UPDATE/DELETE/TRUNCATE). Fields follow spec 21.2.
/// actorUserId / targetId are deliberately NOT foreign keys: audit history must outlive, and never
/// block changes to, the records it describes (targets are polymorphic).
model AuditEvent {
  id            String         @id @default(cuid())
  tenantId      String
  occurredAt    DateTime       @default(now()) @db.Timestamptz(3)
  actorType     AuditActorType @default(USER)
  actorUserId   String?
  action        String
  targetType    String?
  targetId      String?
  previousValue Json?
  newValue      Json?
  reason        String?
  outcome       AuditOutcome   @default(SUCCESS)
  sourceApp     SourceApp      @default(API)
  correlationId String?
  ipAddress     String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([id, tenantId])
  @@index([tenantId, occurredAt])
  @@index([tenantId, targetType, targetId])
  @@index([tenantId, actorUserId, occurredAt])
  @@index([tenantId, action])
}

model IdempotencyRecord {
  id             String   @id @default(cuid())
  tenantId       String
  key            String
  method         String
  path           String
  requestHash    String
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  expiresAt      DateTime @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([id, tenantId])
  @@unique([tenantId, key])
  @@index([expiresAt])
}

/// Optional per-tenant overrides of the built-in translation catalog.
model TranslationResource {
  id           String    @id @default(cuid())
  tenantId     String
  locale       String
  key          String
  value        String
  /// §16.6: only reviewed overrides are served. Any edit of `value` resets this to false.
  reviewed     Boolean   @default(false)
  reviewedAt   DateTime? @db.Timestamptz(3)
  reviewedById String?
  updatedById  String?
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  updatedBy  User?  @relation("TranslationEditedBy", fields: [updatedById, tenantId], references: [id, tenantId], onDelete: Restrict)
  reviewedBy User?  @relation("TranslationReviewedBy", fields: [reviewedById, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@unique([tenantId, locale, key])
}

// ═════════════════════════════════════════════════════════════════════════════════════════════
// PHASE 2: OPERATIONAL CORE (customers, leads, jobs, qualifications, dispatch, notifications)
//
// Extra conventions for this section (details: docs/ERD.md "Phase 2", docs/DECISIONS.md "Phase 2 Task 1")
// - Status enums are language-neutral identifiers. Allowed transitions live in ONE pure module per entity
//   (src/lib/<entity>-lifecycle.ts), never in the database; the *StatusHistory tables are append-only.
// - The CURRENT assignee of a lead/job is the ACTIVE row of LeadAssignment / JobAssignment (single source
//   of truth, no denormalized "assignedTo" column). ASSIGNED scope resolves through those rows.
// - Money = integer minor units (cents) + ISO-4217 currency. Never floats.
// - Phone numbers are stored as typed AND normalized (E.164, "+15551234567") for matching; emails are
//   stored lower-case (CHECK). Both feed duplicate detection and search.
// - Human-friendly numbers (customer/lead/job) come from NumberSequence, unique per tenant.
// - Open-ended log vocabularies (notification event types, job event types) are dotted lower-case STRINGS
//   (CHECK-validated), not enums, so a later task can add a value without a schema migration.
// - Hand-written constraints (CHECKs, partial unique indexes, append-only triggers) are in the migration
//   SQL and verified by tests/db/phase2-schema.test.ts.
// ═════════════════════════════════════════════════════════════════════════════════════════════

// ───────────────────────── Phase 2 enums ─────────────────────────

enum ContactChannel {
  PHONE
  SMS
  EMAIL
  IN_PERSON
  CHAT
  OTHER
}

enum CustomerKind {
  INDIVIDUAL
  BUSINESS
}

enum LeadSourceType {
  MANUAL
  PHONE
  WEBSITE
  MARKETING_CAMPAIGN
  EXTERNAL_CRM
  API
  IMPORT
  INTEGRATION
}

/// Spec 6.3. Valid transitions are defined in src/lib/lead-lifecycle.ts.
enum LeadStatus {
  NEW
  UNASSIGNED
  ASSIGNED
  CONTACT_ATTEMPTED
  CONTACTED
  QUALIFIED
  SCHEDULED
  DISPATCHED
  CONVERTED
  LOST
  DUPLICATE
  CANCELLED
}

/// Shared by leads and jobs.
enum WorkPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/// ACTIVE = the current owner/assignee; ENDED = history (reassigned, unassigned, completed).
enum AssignmentState {
  ACTIVE
  ENDED
}

enum InteractionKind {
  CONTACT_ATTEMPT
  NOTE
  CUSTOMER_MESSAGE
  FOLLOW_UP
}

enum InteractionDirection {
  OUTBOUND
  INBOUND
  INTERNAL
}

enum ContactOutcome {
  REACHED
  NO_ANSWER
  VOICEMAIL
  BUSY
  WRONG_NUMBER
  CALLBACK_REQUESTED
  DECLINED
}

enum DuplicateKind {
  LEAD_LEAD
  CUSTOMER_CUSTOMER
  LEAD_CUSTOMER
}

enum DuplicateMatchField {
  PHONE
  EMAIL
  ADDRESS
  NAME
  EXTERNAL_ID
  RECENT_HISTORY
}

enum DuplicateStatus {
  OPEN
  NOT_DUPLICATE
  CONFIRMED_DUPLICATE
}

enum JobOrigin {
  LEAD_CONVERSION
  RECURRING_AGREEMENT
  MANUAL
  INTEGRATION
  CUSTOMER_FOLLOW_UP
}

/// Spec 7.2 (default path first, then exceptional statuses). Transitions: src/lib/job-lifecycle.ts.
enum JobStatus {
  CREATED
  PENDING_ASSIGNMENT
  ASSIGNED
  SCHEDULED
  EN_ROUTE
  ARRIVED
  IN_PROGRESS
  COMPLETED
  AWAITING_REVIEW
  CLOSED
  CANCELLED
  CUSTOMER_UNAVAILABLE
  RESCHEDULED
  FAILED
  ON_HOLD
  REQUIRES_RETURN_VISIT
}

enum JobAssignmentRole {
  LEAD
  CREW
}

enum AssignmentMethod {
  MANUAL
  RECOMMENDATION_APPROVED
  RECOMMENDATION_MODIFIED
  OVERRIDE
}

enum RequirementSource {
  JOB_TYPE
  MANUAL
}

/// SKILL has no Certification row; the other three are the Certification.type values.
enum QualificationKind {
  SKILL
  CERTIFICATION
  LICENSE
  EQUIPMENT
  /// Completed training course (spec 10.1 "Training"); a Certification catalog row of this type.
  TRAINING
}

enum CustomerEmployeePreference {
  PREFERRED
  AVOID
}

enum QualificationStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  REVOKED
}

enum AvailabilityKind {
  WEEKLY_WINDOW
  EXCEPTION_AVAILABLE
  EXCEPTION_UNAVAILABLE
}

/// Spec 7.5. RULE_BASED_AUTO and OPTIMIZATION exist as configuration values only; the service refuses them in Phase 2.
enum DispatchMode {
  MANUAL
  AI_ASSISTED
  RULE_BASED_AUTO
  OPTIMIZATION
}

enum DispatchRecommendationStatus {
  PENDING
  APPROVED
  MODIFIED
  REJECTED
  SUPERSEDED
}

/// Spec 14.1.
enum NotificationChannel {
  IN_APP
  PUSH
  EMAIL
  SMS
}

/// NOT_CONFIGURED = the channel has no provider; recorded truthfully, never faked as sent (spec 28.3).
/// SKIPPED = the recipient opted out of this non-critical channel.
enum DeliveryStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  NOT_CONFIGURED
  SKIPPED
}

enum RetryStatus {
  NONE
  SCHEDULED
  EXHAUSTED
}

// ───────────────────────── Platform helpers ─────────────────────────

/// Per-tenant counters for human-friendly numbers ("J-1042"). Increment atomically:
/// INSERT ... ON CONFLICT (tenantId, name) DO UPDATE SET "lastValue" = "lastValue" + 1 RETURNING "lastValue".
/// Names in use: "customer", "lead", "job".
model NumberSequence {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([id, tenantId])
  @@unique([tenantId, name])
}

/// ONE row per tenant (created lazily by the services; absent = the defaults below). Holds the
/// tenant-level knobs of the operational modules. Tenants may only NARROW lifecycles: the disabled
/// lists name optional transitions ("FROM>TO", e.g. "CREATED>CANCELLED") a tenant switched off; the
/// lifecycle modules ignore entries that are not valid optional transitions.
model OperationsSettings {
  id                        String                @id @default(cuid())
  tenantId                  String
  dispatchMode              DispatchMode          @default(AI_ASSISTED)
  disabledLeadTransitions   String[]              @default([])
  disabledJobTransitions    String[]              @default([])
  /// Duplicate matchers, e.g. {"phone":true,"email":true,"address":true,"name":false}. Null = defaults.
  duplicateMatchers         Json?
  enabledChannels           NotificationChannel[] @default([IN_APP])
  /// Spec 25.1: a contact attempt counts as "open" (blocks silent reassignment) for this long.
  contactAttemptOpenMinutes Int                   @default(30)
  /// Days before expiry at which "certification expiring" notifications are raised.
  qualificationWarningDays  Int                   @default(30)
  defaultCurrency           String                @default("USD") @db.Char(3)
  /// Phase 3. Arrival geofence radius in meters, used when the address has no override (spec 17.2).
  arrivalGeofenceRadiusM    Int                   @default(150)
  /// A location with a worse (larger) accuracy radius than this is never used for verification or presence.
  locationMaxAccuracyM      Int                   @default(100)
  /// Presence for recovery (spec 26.5) is only shown from a location newer than this.
  presenceMaxAgeMinutes     Int                   @default(30)
  /// Location history (spec 22.2) is kept this long, then purged by the retention job.
  locationRetentionDays     Int                   @default(90)
  /// The follow-up sweep raises "due soon" this many minutes before a task is due.
  followUpDueSoonMinutes    Int                   @default(60)
  updatedAt                 DateTime              @updatedAt @db.Timestamptz(3)
  updatedById               String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  updatedBy User? @relation("OperationsSettingsUpdatedBy", fields: [updatedById, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@unique([tenantId])
}

// ───────────────────────── Customers (spec 6.1) ─────────────────────────

model Customer {
  id                      String          @id @default(cuid())
  tenantId                String
  /// Human-friendly number from NumberSequence "customer"; unique per tenant.
  number                  Int
  kind                    CustomerKind    @default(INDIVIDUAL)
  /// Display name (person or company).
  name                    String
  email                   String?
  phone                   String?
  /// `phone` normalized to E.164 ("+15551234567"); the matching and search key.
  phoneE164               String?
  preferredLocale         String?
  preferredContactChannel ContactChannel?
  /// Free-form preferences (quiet hours, do-not-text windows...). Opt-outs that matter are columns.
  contactPreferences      Json?
  doNotContact            Boolean         @default(false)
  /// Service-area org unit (branch/city). Drives ORG_UNIT scope; null = tenant-level only.
  orgUnitId               String?
  // Billing field set (`customers.billing_fields`, tag "billing"): opt-in, see authz field-maps.ts.
  billingName             String?
  billingEmail            String?
  billingAddress          Json?
  taxId                   String?
  paymentTerms            String?
  archivedAt              DateTime?       @db.Timestamptz(3)
  createdById             String?
  createdAt               DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime        @updatedAt @db.Timestamptz(3)

  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  orgUnit        OrgUnit?          @relation(fields: [orgUnitId, tenantId], references: [id, tenantId], onDelete: Restrict)
  createdBy      User?             @relation("CustomerCreatedBy", fields: [createdById, tenantId], references: [id, tenantId], onDelete: Restrict)
  addresses      CustomerAddress[]
  notes          CustomerNote[]
  leads          Lead[]
  jobs           Job[]
  flagsAsPrimary DuplicateFlag[]   @relation("DuplicateCustomer")
  flagsAsOther   DuplicateFlag[]   @relation("DuplicateOtherCustomer")

  preferredEmployees CustomerPreferredEmployee[]

  // Phase 3
  recoveryCases LeadRecoveryCase[]
  followUpTasks FollowUpTask[]

  recoveryRuleRuns RecoveryRuleRun[]

  ledgerEntries    LedgerEntry[]
  payments         Payment[]
  refunds          Refund[]
  chargebacks      Chargeback[]
  adjustments      Adjustment[]
  approvalRequests ApprovalRequest[]

  @@unique([id, tenantId])
  @@unique([tenantId, number])
  @@index([tenantId, archivedAt, createdAt])
  @@index([tenantId, phoneE164])
  @@index([tenantId, email])
  @@index([tenantId, orgUnitId])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Customer_name_trgm_idx")
}

/// Service (and optionally other) addresses of a customer. Coordinates are optional: no geocoding
/// provider is integrated in Phase 2, so they exist only when entered or imported (spec 28.3).
model CustomerAddress {
  id                 String    @id @default(cuid())
  tenantId           String
  customerId         String
  label              String?
  line1              String
  line2              String?
  city               String
  /// State / province / region.
  region             String
  postalCode         String
  /// ISO 3166-1 alpha-2.
  countryCode        String    @default("US") @db.Char(2)
  latitude           Decimal?  @db.Decimal(9, 6)
  longitude          Decimal?  @db.Decimal(9, 6)
  /// How the coordinates were obtained ("manual", "import", ...). Null when there are none.
  coordinateSource   String?
  /// Per-site arrival geofence radius in meters (large sites); null = the tenant default (OperationsSettings).
  geofenceRadiusM    Int?
  /// Lower-case "line1|line2|city|region|postalCode|country" with collapsed whitespace; the
  /// duplicate-address matching key, computed by the customers service.
  normalizedKey      String
  accessInstructions String?   @db.Text
  isPrimary          Boolean   @default(false)
  /// Service-area org unit for this address (branch/city); copied to jobs created for it.
  orgUnitId          String?
  archivedAt         DateTime? @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(3)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer Customer @relation(fields: [customerId, tenantId], references: [id, tenantId], onDelete: Restrict)
  orgUnit  OrgUnit? @relation(fields: [orgUnitId, tenantId], references: [id, tenantId], onDelete: Restrict)
  leads    Lead[]
  jobs     Job[]

  @@unique([id, tenantId])
  // Lets Lead/Job reference (address, customer) together so an address can never belong to another customer.
  @@unique([id, customerId, tenantId])
  @@index([tenantId, customerId])
  @@index([tenantId, normalizedKey])
  @@index([tenantId, orgUnitId])
  @@index([tenantId, postalCode])
}

model CustomerNote {
  id         String   @id @default(cuid())
  tenantId   String
  customerId String
  authorId   String?
  body       String   @db.Text
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer Customer @relation(fields: [customerId, tenantId], references: [id, tenantId], onDelete: Restrict)
  author   User?    @relation("CustomerNoteAuthor", fields: [authorId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@index([tenantId, customerId, createdAt])
}

// ───────────────────────── Leads (spec 6.2-6.4) ─────────────────────────

model LeadSource {
  id        String         @id @default(cuid())
  tenantId  String
  /// Stable lower-case key, unique per tenant (CHECK: ^[a-z0-9][a-z0-9_-]{0,62}$).
  code      String
  name      String
  type      LeadSourceType
  active    Boolean        @default(true)
  createdAt DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  leads  Lead[]

  @@unique([id, tenantId])
  @@unique([tenantId, code])
}

model Lead {
  id                   String       @id @default(cuid())
  tenantId             String
  /// Human-friendly number from NumberSequence "lead".
  number               Int
  status               LeadStatus   @default(NEW)
  statusChangedAt      DateTime     @default(now()) @db.Timestamptz(3)
  priority             WorkPriority @default(NORMAL)
  sourceId             String?
  /// Marketing campaign label.
  campaign             String?
  /// Id of the lead in the external system; with `sourceId` it makes webhook retries idempotent (spec 25.1).
  externalId           String?
  /// Known customer, once linked or created. Null while the lead is still an unknown contact.
  customerId           String?
  // Contact as received (a lead may arrive before any Customer exists).
  contactName          String?
  contactPhone         String?
  contactPhoneE164     String?
  contactEmail         String?
  customerAddressId    String?
  // Address as received when no CustomerAddress is linked (may be incomplete, spec 25.1).
  addressLine1         String?
  addressLine2         String?
  addressCity          String?
  addressRegion        String?
  addressPostalCode    String?
  /// Matching key, same format as CustomerAddress.normalizedKey.
  addressNormalizedKey String?
  jobTypeId            String?
  /// Category as received when no JobType matches.
  serviceCategory      String?
  requestedWork        String?      @db.Text
  preferredWindowStart DateTime?    @db.Timestamptz(3)
  preferredWindowEnd   DateTime?    @db.Timestamptz(3)
  preferredTimeNote    String?
  notes                String?      @db.Text
  quotedAmountMinor    BigInt?
  currency             String       @default("USD") @db.Char(3)
  /// Service-area org unit (routing). Null = unrouted, visible only to tenant-level scopes.
  orgUnitId            String?
  nextFollowUpAt       DateTime?    @db.Timestamptz(3)
  /// Set when status = DUPLICATE: the lead this one duplicates.
  duplicateOfLeadId    String?
  /// Reason when status = LOST or CANCELLED (the full trail is in LeadStatusHistory).
  closedReason         String?
  archivedAt           DateTime?    @db.Timestamptz(3)
  createdById          String?
  createdAt            DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime     @updatedAt @db.Timestamptz(3)

  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  source         LeadSource?         @relation(fields: [sourceId, tenantId], references: [id, tenantId], onDelete: Restrict)
  customer       Customer?           @relation(fields: [customerId, tenantId], references: [id, tenantId], onDelete: Restrict)
  address        CustomerAddress?    @relation(fields: [customerAddressId, customerId, tenantId], references: [id, customerId, tenantId], onDelete: Restrict)
  jobType        JobType?            @relation(fields: [jobTypeId, tenantId], references: [id, tenantId], onDelete: Restrict)
  orgUnit        OrgUnit?            @relation(fields: [orgUnitId, tenantId], references: [id, tenantId], onDelete: Restrict)
  duplicateOf    Lead?               @relation("LeadDuplicateOf", fields: [duplicateOfLeadId, tenantId], references: [id, tenantId], onDelete: Restrict)
  duplicates     Lead[]              @relation("LeadDuplicateOf")
  createdBy      User?               @relation("LeadCreatedBy", fields: [createdById, tenantId], references: [id, tenantId], onDelete: Restrict)
  assignments    LeadAssignment[]
  statusHistory  LeadStatusHistory[]
  interactions   LeadInteraction[]
  jobs           Job[]
  flagsAsPrimary DuplicateFlag[]     @relation("DuplicateLead")
  flagsAsOther   DuplicateFlag[]     @relation("DuplicateOtherLead")

  // Phase 3
  recoveryCases LeadRecoveryCase[]
  followUpTasks FollowUpTask[]

  recoveredByCases LeadRecoveryCase[] @relation("RecoveredLead")

  @@unique([id, tenantId])
  @@unique([id, customerId, tenantId])
  @@unique([tenantId, number])
  @@unique([tenantId, sourceId, externalId])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, status, nextFollowUpAt])
  @@index([tenantId, orgUnitId, status])
  @@index([tenantId, priority, status])
  @@index([tenantId, customerId])
  @@index([tenantId, sourceId, createdAt])
  @@index([tenantId, contactPhoneE164])
  @@index([tenantId, contactEmail])
  @@index([tenantId, addressNormalizedKey])
  @@index([tenantId, archivedAt, createdAt])
  @@index([contactName(ops: raw("gin_trgm_ops"))], type: Gin, map: "Lead_contactName_trgm_idx")
}

/// Who owns a lead, over time. At most one ACTIVE row per lead (partial unique index in the migration).
model LeadAssignment {
  id                String          @id @default(cuid())
  tenantId          String
  leadId            String
  employeeId        String
  state             AssignmentState @default(ACTIVE)
  assignedAt        DateTime        @default(now()) @db.Timestamptz(3)
  assignedById      String?
  /// Why it was assigned/reassigned (the service requires it when replacing another owner).
  reason            String?
  /// Spec 25.1: true when the reassignment happened while another employee had an open contact
  /// attempt and the assigner explicitly confirmed it.
  conflictConfirmed Boolean         @default(false)
  endedAt           DateTime?       @db.Timestamptz(3)
  endedReason       String?

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  lead       Lead     @relation(fields: [leadId, tenantId], references: [id, tenantId], onDelete: Restrict)
  employee   Employee @relation(fields: [employeeId, tenantId], references: [id, tenantId], onDelete: Restrict)
  assignedBy User?    @relation("LeadAssignmentAssignedBy", fields: [assignedById, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@index([tenantId, employeeId, state])
  @@index([tenantId, leadId, state])
}

/// Append-only (trigger). One row per status change; the initial status is a row with fromStatus null.
model LeadStatusHistory {
  id          String         @id @default(cuid())
  tenantId    String
  leadId      String
  fromStatus  LeadStatus?
  toStatus    LeadStatus
  actorType   AuditActorType @default(USER)
  actorUserId String?
  reason      String?
  occurredAt  DateTime       @default(now()) @db.Timestamptz(3)

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  lead      Lead   @relation(fields: [leadId, tenantId], references: [id, tenantId], onDelete: Restrict)
  changedBy User?  @relation("LeadStatusChangedBy", fields: [actorUserId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@index([tenantId, leadId, occurredAt])
  @@index([tenantId, toStatus, occurredAt])
}

/// Contact attempts, notes and customer messages on a lead. A CONTACT_ATTEMPT is "open" (spec 25.1)
/// while `closedAt` is null and it is newer than OperationsSettings.contactAttemptOpenMinutes.
model LeadInteraction {
  id              String               @id @default(cuid())
  tenantId        String
  leadId          String
  kind            InteractionKind
  direction       InteractionDirection @default(OUTBOUND)
  channel         ContactChannel?
  outcome         ContactOutcome?
  body            String?              @db.Text
  occurredAt      DateTime             @default(now()) @db.Timestamptz(3)
  closedAt        DateTime?            @db.Timestamptz(3)
  durationSeconds Int?
  /// When kind = FOLLOW_UP (or an attempt asked for one): the due date it set.
  followUpAt      DateTime?            @db.Timestamptz(3)
  authorId        String?
  createdAt       DateTime             @default(now()) @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  lead   Lead   @relation(fields: [leadId, tenantId], references: [id, tenantId], onDelete: Restrict)
  author User?  @relation("LeadInteractionAuthor", fields: [authorId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@index([tenantId, leadId, occurredAt])
  @@index([tenantId, kind, closedAt, occurredAt])
}

/// A pair flagged as possible duplicates. Never merged automatically (spec 6.4). Exactly one row per
/// pair: `pairKey` = "<kind>:<idA>:<idB>" (ids of the same type in sorted order; a CHECK enforces the
/// ordering on the id columns), unique per tenant.
///   LEAD_LEAD         -> leadId, otherLeadId
///   CUSTOMER_CUSTOMER -> customerId, otherCustomerId
///   LEAD_CUSTOMER     -> leadId, customerId (a lead whose contact matches an existing customer)
model DuplicateFlag {
  id              String                @id @default(cuid())
  tenantId        String
  kind            DuplicateKind
  pairKey         String
  leadId          String?
  otherLeadId     String?
  customerId      String?
  otherCustomerId String?
  matchedOn       DuplicateMatchField[]
  /// Human-readable explanation (e.g. "same phone +15551234567").
  reason          String?
  status          DuplicateStatus       @default(OPEN)
  detectedAt      DateTime              @default(now()) @db.Timestamptz(3)
  resolvedAt      DateTime?             @db.Timestamptz(3)
  resolvedById    String?
  resolutionNote  String?

  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  lead          Lead?     @relation("DuplicateLead", fields: [leadId, tenantId], references: [id, tenantId], onDelete: Restrict)
  otherLead     Lead?     @relation("DuplicateOtherLead", fields: [otherLeadId, tenantId], references: [id, tenantId], onDelete: Restrict)
  customer      Customer? @relation("DuplicateCustomer", fields: [customerId, tenantId], references: [id, tenantId], onDelete: Restrict)
  otherCustomer Customer? @relation("DuplicateOtherCustomer", fields: [otherCustomerId, tenantId], references: [id, tenantId], onDelete: Restrict)
  resolvedBy    User?     @relation("DuplicateFlagResolvedBy", fields: [resolvedById, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@unique([tenantId, pairKey])
  @@index([tenantId, status, detectedAt])
  @@index([tenantId, leadId, status])
  @@index([tenantId, otherLeadId])
  @@index([tenantId, customerId, status])
  @@index([tenantId, otherCustomerId])
}

// ───────────────────────── Workforce qualifications (spec 10.1) ─────────────────────────

model Skill {
  id          String   @id @default(cuid())
  tenantId    String
  /// Stable lower-case key, unique per tenant (CHECK: ^[a-z0-9][a-z0-9_-]{0,62}$).
  code        String
  name        String
  category    String?
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  tenant          Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  jobTypes        JobTypeSkill[]
  jobRequirements JobRequirement[]
  qualifications  EmployeeQualification[]

  @@unique([id, tenantId])
  @@unique([tenantId, code])
}

/// Catalog of credentials: `type` CERTIFICATION, LICENSE or EQUIPMENT (an authorization to operate a
/// piece of equipment). Never SKILL (CHECK). Skills live in Skill.
model Certification {
  id               String            @id @default(cuid())
  tenantId         String
  code             String
  name             String
  type             QualificationKind @default(CERTIFICATION)
  issuingAuthority String?
  /// Typical validity; the actual expiry is on the employee's qualification. Null = does not expire by default.
  validityMonths   Int?
  /// The employee's qualification must carry a credential number (licenses usually do).
  requiresNumber   Boolean           @default(false)
  description      String?
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(3)

  tenant          Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  jobTypes        JobTypeCertification[]
  jobRequirements JobRequirement[]
  qualifications  EmployeeQualification[]

  @@unique([id, tenantId])
  @@unique([id, type, tenantId])
  @@unique([tenantId, code])
  @@index([tenantId, type])
}

/// An employee holds a skill OR a credential (exactly one of skillId / certificationId; `kind`
/// names which, and a CHECK ties it to the id columns; the service ties it to Certification.type).
/// A renewed credential is a NEW row (history); skills are unique per employee.
/// Eligibility counts a row only when status = VERIFIED and it is not expired.
model EmployeeQualification {
  id               String              @id @default(cuid())
  tenantId         String
  employeeId       String
  kind             QualificationKind
  skillId          String?
  certificationId  String?
  /// Proficiency 1-5 for skills (CHECK). Null for credentials.
  level            Int?
  /// License / certificate number.
  number           String?
  issuingAuthority String?
  issuedAt         DateTime?           @db.Date
  /// Null = does not expire.
  expiresAt        DateTime?           @db.Date
  status           QualificationStatus @default(PENDING_VERIFICATION)
  verifiedById     String?
  verifiedAt       DateTime?           @db.Timestamptz(3)
  notes            String?
  createdAt        DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @db.Timestamptz(3)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee      Employee       @relation(fields: [employeeId, tenantId], references: [id, tenantId], onDelete: Restrict)
  skill         Skill?         @relation(fields: [skillId, tenantId], references: [id, tenantId], onDelete: Restrict)
  certification Certification? @relation(fields: [certificationId, kind, tenantId], references: [id, type, tenantId], onDelete: Restrict)
  verifiedBy    User?          @relation("QualificationVerifiedBy", fields: [verifiedById, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@unique([tenantId, employeeId, skillId])
  @@index([tenantId, employeeId, status])
  @@index([tenantId, skillId])
  @@index([tenantId, certificationId])
  @@index([tenantId, expiresAt])
}

/// Which org units an employee may be dispatched into (geographic restriction, spec 10.1 / 7.3
/// "approved service territory"). Covers descendants of the unit when includeDescendants.
model ServiceTerritory {
  id                 String    @id @default(cuid())
  tenantId           String
  employeeId         String
  orgUnitId          String
  includeDescendants Boolean   @default(true)
  effectiveFrom      DateTime  @default(now()) @db.Timestamptz(3)
  effectiveTo        DateTime? @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [employeeId, tenantId], references: [id, tenantId], onDelete: Restrict)
  orgUnit  OrgUnit  @relation(fields: [orgUnitId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@unique([tenantId, employeeId, orgUnitId])
  @@index([tenantId, orgUnitId])
}

/// Employee availability, time-zone aware. Two shapes in one table (CHECKs keep them apart):
///  - WEEKLY_WINDOW: recurring on `isoDayOfWeek` (1 = Monday .. 7 = Sunday) from `startMinute` to
///    `endMinute` (minutes after LOCAL midnight in `timeZone`), optionally bounded by validFrom/validTo.
///    Several windows on a day = split shift.
///  - EXCEPTION_AVAILABLE / EXCEPTION_UNAVAILABLE: a concrete UTC interval [startsAt, endsAt) that
///    adds availability or blocks it (time off, sick leave). Exceptions beat weekly windows.
model Availability {
  id           String           @id @default(cuid())
  tenantId     String
  employeeId   String
  kind         AvailabilityKind
  /// IANA zone name the window is interpreted in (validated by the service).
  timeZone     String
  isoDayOfWeek Int?
  startMinute  Int?
  endMinute    Int?
  validFrom    DateTime?        @db.Date
  validTo      DateTime?        @db.Date
  startsAt     DateTime?        @db.Timestamptz(3)
  endsAt       DateTime?        @db.Timestamptz(3)
  note         String?
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @db.Timestamptz(3)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [employeeId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@index([tenantId, employeeId, kind, isoDayOfWeek])
  @@index([tenantId, employeeId, startsAt, endsAt])
}

// ───────────────────────── Jobs (spec 7.1-7.2) ─────────────────────────

model JobType {
  id                     String       @id @default(cuid())
  tenantId               String
  /// Stable lower-case key, unique per tenant.
  code                   String
  name                   String
  /// Job category (spec 7.1), tenant-defined, e.g. "installation", "repair", "inspection".
  category               String
  description            String?
  defaultDurationMinutes Int
  defaultPriority        WorkPriority @default(NORMAL)
  /// Completed jobs of this type pass through AWAITING_REVIEW before CLOSED (spec 7.2).
  requiresReview         Boolean      @default(false)
  /// What to bring / have on site, shown to technicians. Informational: it is NOT an eligibility rule
  /// (eligibility uses required skills and certifications, incl. EQUIPMENT-type qualifications).
  requiredEquipment      String[]     @default([])
  /// Placeholder for the Phase 3 completion form definition (spec 8.6). Phase 2 stores, never interprets it.
  completionFormSchema   Json?
  active                 Boolean      @default(true)
  createdAt              DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime     @updatedAt @db.Timestamptz(3)

  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  skills         JobTypeSkill[]
  certifications JobTypeCertification[]
  jobs           Job[]
  leads          Lead[]

  employeePermissions EmployeeJobPermission[]

  // Phase 3
  completionForms JobCompletionFormDefinition[]

  @@unique([id, tenantId])
  @@unique([tenantId, code])
  @@index([tenantId, category])
}

model JobTypeSkill {
  tenantId  String
  jobTypeId String
  skillId   String
  /// Minimum proficiency 1-5; null = any level.
  minLevel  Int?

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  jobType JobType @relation(fields: [jobTypeId, tenantId], references: [id, tenantId], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@id([jobTypeId, skillId])
  @@index([tenantId, skillId])
}

/// Certifications, licenses and equipment qualifications a job type requires.
model JobTypeCertification {
  tenantId        String
  jobTypeId       String
  certificationId String

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  jobType       JobType       @relation(fields: [jobTypeId, tenantId], references: [id, tenantId], onDelete: Cascade)
  certification Certification @relation(fields: [certificationId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@id([jobTypeId, certificationId])
  @@index([tenantId, certificationId])
}

model Job {
  id                       String       @id @default(cuid())
  tenantId                 String
  /// Human-friendly number from NumberSequence "job".
  number                   Int
  customerId               String
  serviceAddressId         String
  jobTypeId                String
  /// Service-area org unit (branch/city/team). Drives ORG_UNIT scope and the territory check.
  orgUnitId                String
  /// The lead this job was created from (at most one job per converted lead).
  leadId                   String?
  /// Original job when this is a return visit / follow-up.
  parentJobId              String?
  origin                   JobOrigin    @default(MANUAL)
  status                   JobStatus    @default(CREATED)
  statusChangedAt          DateTime     @default(now()) @db.Timestamptz(3)
  priority                 WorkPriority @default(NORMAL)
  title                    String
  /// Work description (customer-facing wording).
  description              String?      @db.Text
  /// Instructions for the technician (access, hazards, what to bring).
  instructions             String?      @db.Text
  /// Customer-facing arrival window (UTC instants). Both or neither; end > start.
  appointmentWindowStart   DateTime?    @db.Timestamptz(3)
  appointmentWindowEnd     DateTime?    @db.Timestamptz(3)
  /// The dispatcher's concrete slot. Both or neither; end > start.
  scheduledStartAt         DateTime?    @db.Timestamptz(3)
  scheduledEndAt           DateTime?    @db.Timestamptz(3)
  /// IANA zone the appointment is expressed in; null = the org unit's, then the tenant's.
  timeZone                 String?
  estimatedDurationMinutes Int
  quotedAmountMinor        BigInt?
  currency                 String       @default("USD") @db.Char(3)
  /// Phase 3 execution milestones (denormalized for lists; the full trail is JobEvent).
  /// The visit being worked: JobOutcome / JobCompletion rows of this job use it as `visitNumber`. Starts at 1 and is
  /// incremented by the jobs lifecycle (in the same transaction as the status change) when a job whose visit already has an
  /// outcome goes back to SCHEDULED after REQUIRES_RETURN_VISIT / RESCHEDULED / CUSTOMER_UNAVAILABLE.
  currentVisitNumber       Int          @default(1)
  enRouteAt                DateTime?    @db.Timestamptz(3)

  arrivedAt    DateTime? @db.Timestamptz(3)
  startedAt    DateTime? @db.Timestamptz(3)
  completedAt  DateTime? @db.Timestamptz(3)
  closedAt     DateTime? @db.Timestamptz(3)
  cancelledAt  DateTime? @db.Timestamptz(3)
  /// Reason when CANCELLED / FAILED / ON_HOLD etc. (the full trail is in JobStatusHistory).
  statusReason String?
  archivedAt   DateTime? @db.Timestamptz(3)
  createdById  String?
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  tenant          Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer        Customer                 @relation(fields: [customerId, tenantId], references: [id, tenantId], onDelete: Restrict)
  serviceAddress  CustomerAddress          @relation(fields: [serviceAddressId, customerId, tenantId], references: [id, customerId, tenantId], onDelete: Restrict)
  jobType         JobType                  @relation(fields: [jobTypeId, tenantId], references: [id, tenantId], onDelete: Restrict)
  orgUnit         OrgUnit                  @relation(fields: [orgUnitId, tenantId], references: [id, tenantId], onDelete: Restrict)
  lead            Lead?                    @relation(fields: [leadId, customerId, tenantId], references: [id, customerId, tenantId], onDelete: Restrict)
  parentJob       Job?                     @relation("JobFollowUps", fields: [parentJobId, tenantId], references: [id, tenantId], onDelete: Restrict)
  followUps       Job[]                    @relation("JobFollowUps")
  createdBy       User?                    @relation("JobCreatedBy", fields: [createdById, tenantId], references: [id, tenantId], onDelete: Restrict)
  requirements    JobRequirement[]
  assignments     JobAssignment[]
  statusHistory   JobStatusHistory[]
  events          JobEvent[]
  recommendations DispatchRecommendation[]

  // Phase 3
  locationEvents       LocationEvent[]
  arrivalVerifications ArrivalVerification[]
  fieldEvents          FieldEvent[]
  completions          JobCompletion[]
  materialUsages       JobMaterialUsage[]
  fieldNotes           JobFieldNote[]
  attachments          JobAttachment[]
  outcomes             JobOutcome[]
  recoveryCases        LeadRecoveryCase[]    @relation("RecoveryCaseJob")
  recoveredByCases     LeadRecoveryCase[]    @relation("RecoveredJob")
  followUpTasks        FollowUpTask[]

  ledgerEntries            LedgerEntry[]
  payments                 Payment[]
  refunds                  Refund[]
  chargebacks              Chargeback[]
  adjustments              Adjustment[]
  approvalRequests         ApprovalRequest[]
  reconciliationExceptions ReconciliationException[]
  paymentIntakeEvents      PaymentIntakeEvent[]

  @@unique([id, tenantId])
  // Lets a recovery case reference (job, customer) so a case and its job can never disagree on the customer.
  @@unique([id, customerId, tenantId])
  @@unique([tenantId, number])
  @@unique([leadId, tenantId])
  @@index([tenantId, status, scheduledStartAt])
  @@index([tenantId, orgUnitId, status, scheduledStartAt])
  @@index([tenantId, scheduledStartAt])
  @@index([tenantId, appointmentWindowStart])
  @@index([tenantId, customerId, createdAt])
  @@index([tenantId, jobTypeId, status])
  @@index([tenantId, priority, status])
  @@index([tenantId, parentJobId])
  @@index([tenantId, archivedAt, createdAt])
}

/// What THIS job requires (copied from the job type at creation, plus manual additions such as
/// "requires additional qualification", spec 25.2). The eligibility engine reads only this table.
/// Exactly one of skillId / certificationId (CHECK).
model JobRequirement {
  id              String            @id @default(cuid())
  tenantId        String
  jobId           String
  skillId         String?
  certificationId String?
  minLevel        Int?
  source          RequirementSource @default(JOB_TYPE)
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  job           Job            @relation(fields: [jobId, tenantId], references: [id, tenantId], onDelete: Restrict)
  skill         Skill?         @relation(fields: [skillId, tenantId], references: [id, tenantId], onDelete: Restrict)
  certification Certification? @relation(fields: [certificationId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@unique([tenantId, jobId, skillId])
  @@unique([tenantId, jobId, certificationId])
  @@index([tenantId, skillId])
  @@index([tenantId, certificationId])
}

/// Who does a job, over time: an employee (LEAD or CREW) or a whole team org unit (exactly one of
/// employeeId / teamOrgUnitId, CHECK). ACTIVE rows are the current crew: at most one ACTIVE LEAD per
/// job and one ACTIVE row per (job, employee) (partial unique indexes in the migration).
model JobAssignment {
  id               String            @id @default(cuid())
  tenantId         String
  jobId            String
  employeeId       String?
  teamOrgUnitId    String?
  role             JobAssignmentRole @default(LEAD)
  state            AssignmentState   @default(ACTIVE)
  method           AssignmentMethod  @default(MANUAL)
  /// Required (CHECK) when method = OVERRIDE: why the dispatcher departed from the recommendation or the rules.
  overrideReason   String?
  /// The recommendation this assignment came from (APPROVED / MODIFIED), if any.
  recommendationId String?
  assignedAt       DateTime          @default(now()) @db.Timestamptz(3)
  assignedById     String?
  reason           String?
  endedAt          DateTime?         @db.Timestamptz(3)
  endedReason      String?

  tenant         Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  job            Job                     @relation(fields: [jobId, tenantId], references: [id, tenantId], onDelete: Restrict)
  employee       Employee?               @relation(fields: [employeeId, tenantId], references: [id, tenantId], onDelete: Restrict)
  teamOrgUnit    OrgUnit?                @relation(fields: [teamOrgUnitId, tenantId], references: [id, tenantId], onDelete: Restrict)
  assignedBy     User?                   @relation("JobAssignmentAssignedBy", fields: [assignedById, tenantId], references: [id, tenantId], onDelete: Restrict)
  recommendation DispatchRecommendation? @relation("RecommendationAssignments", fields: [recommendationId, jobId, tenantId], references: [id, jobId, tenantId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@index([tenantId, employeeId, state])
  @@index([tenantId, jobId, state])
  @@index([tenantId, teamOrgUnitId, state])
  @@index([tenantId, recommendationId])
}

/// Append-only (trigger). One row per status change; the initial status is a row with fromStatus null.
model JobStatusHistory {
  id          String         @id @default(cuid())
  tenantId    String
  jobId       String
  fromStatus  JobStatus?
  toStatus    JobStatus
  actorType   AuditActorType @default(USER)
  actorUserId String?
  reason      String?
  occurredAt  DateTime       @default(now()) @db.Timestamptz(3)

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  job       Job    @relation(fields: [jobId, tenantId], references: [id, tenantId], onDelete: Restrict)
  changedBy User?  @relation("JobStatusChangedBy", fields: [actorUserId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@index([tenantId, jobId, occurredAt])
  @@index([tenantId, toStatus, occurredAt])
}

/// Append-only (trigger) log of everything that happens to a job (assigned, rescheduled, note, and in
/// Phase 3 arrival / start / completion). `type` is a dotted lower-case key (CHECK
/// ^[a-z][a-z0-9_]*(\.[a-z0-9_]+)*$), e.g. "job.assigned", "job.rescheduled", "dispatch.override".
/// `clientEventId` is the technician app's idempotency key: a double submit (spec 25.3) hits the
/// unique index instead of creating a second event.
model JobEvent {
  id            String         @id @default(cuid())
  tenantId      String
  jobId         String
  type          String
  actorType     AuditActorType @default(USER)
  actorUserId   String?
  /// When it happened (device clock for offline events) vs `recordedAt` (server clock).
  occurredAt    DateTime       @default(now()) @db.Timestamptz(3)
  recordedAt    DateTime       @default(now()) @db.Timestamptz(3)
  clientEventId String?
  payload       Json?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  job    Job    @relation(fields: [jobId, tenantId], references: [id, tenantId], onDelete: Restrict)
  actor  User?  @relation("JobEventActor", fields: [actorUserId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@unique([tenantId, jobId, clientEventId])
  @@index([tenantId, jobId, occurredAt])
  @@index([tenantId, type, occurredAt])
}

/// One dispatch recommendation for a job (spec 7.4): the ranked candidates with every factor and its
/// contribution, the conflicts, or - when nobody is eligible - the blocking reasons (spec 25.2).
/// Rule-based and explainable; the dispatcher decides. All JSON is written by the dispatch service.
model DispatchRecommendation {
  id               String                       @id @default(cuid())
  tenantId         String
  jobId            String
  mode             DispatchMode
  status           DispatchRecommendationStatus @default(PENDING)
  /// Ranked candidates: [{ employeeId, rank, score, factors: [{ key, value, contribution, explanation }], conflicts: [...] }].
  candidates       Json
  /// Per-employee hard-requirement failures (why nobody / this person is not eligible).
  blockingReasons  Json?
  generatedAt      DateTime                     @default(now()) @db.Timestamptz(3)
  generatedById    String?
  /// The employee finally assigned (may differ from rank 1 when MODIFIED / overridden).
  chosenEmployeeId String?
  decidedAt        DateTime?                    @db.Timestamptz(3)
  decidedById      String?
  decisionReason   String?

  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  job         Job             @relation(fields: [jobId, tenantId], references: [id, tenantId], onDelete: Restrict)
  generatedBy User?           @relation("DispatchRecGeneratedBy", fields: [generatedById, tenantId], references: [id, tenantId], onDelete: Restrict)
  decidedBy   User?           @relation("DispatchRecDecidedBy", fields: [decidedById, tenantId], references: [id, tenantId], onDelete: Restrict)
  chosen      Employee?       @relation(fields: [chosenEmployeeId, tenantId], references: [id, tenantId], onDelete: Restrict)
  assignments JobAssignment[] @relation("RecommendationAssignments")

  @@unique([id, tenantId])
  @@unique([id, jobId, tenantId])
  @@index([tenantId, jobId, generatedAt])
  @@index([tenantId, status, generatedAt])
}

// ───────────────────────── Notifications (spec 14) ─────────────────────────

/// One notification for one recipient (the in-app inbox row). The text is NOT stored rendered: it is
/// rendered at read time in the recipient's language from `templateKey` + `params`. Idempotent per
/// (recipient, idempotencyKey) so a retried business action never notifies twice.
/// `eventType` is a dotted lower-case key (CHECK), e.g. "lead.assigned", "job.assigned".
model Notification {
  id             String    @id @default(cuid())
  tenantId       String
  recipientId    String
  eventType      String
  /// The business event it came from (e.g. the lead id + transition) - spec 14.3 "Event ID".
  eventId        String
  idempotencyKey String
  /// i18n key of the message; params are the interpolation values (JSON, language-neutral).
  templateKey    String
  params         Json?
  /// Deep link target, e.g. targetType "job", targetId <jobId>.
  targetType     String?
  targetId       String?
  /// Critical (mandatory security/operational) notifications ignore opt-outs (spec 14.1).
  critical       Boolean   @default(false)
  readAt         DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  tenant     Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  recipient  User                   @relation("NotificationRecipient", fields: [recipientId, tenantId], references: [id, tenantId], onDelete: Restrict)
  deliveries NotificationDelivery[]

  @@unique([id, tenantId])
  @@unique([tenantId, recipientId, idempotencyKey])
  @@index([tenantId, recipientId, readAt, createdAt])
  @@index([tenantId, eventId])
  @@index([tenantId, eventType, createdAt])
}

/// One delivery ATTEMPT of a notification on one channel (spec 14.3): attempt 1, 2, ... Each row
/// records the provider response, failure reason and whether a retry is scheduled. IN_APP is
/// delivered by the notification row itself; EMAIL/SMS/PUSH without a provider record NOT_CONFIGURED.
model NotificationDelivery {
  id               String              @id @default(cuid())
  tenantId         String
  notificationId   String
  channel          NotificationChannel
  attempt          Int                 @default(1)
  status           DeliveryStatus      @default(PENDING)
  provider         String?
  providerResponse Json?
  failureReason    String?
  retryStatus      RetryStatus         @default(NONE)
  nextRetryAt      DateTime?           @db.Timestamptz(3)
  createdAt        DateTime            @default(now()) @db.Timestamptz(3)
  attemptedAt      DateTime?           @db.Timestamptz(3)
  deliveredAt      DateTime?           @db.Timestamptz(3)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  notification Notification @relation(fields: [notificationId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@unique([notificationId, channel, attempt])
  @@index([tenantId, notificationId])
  @@index([tenantId, status, nextRetryAt])
}

/// A user's opt-in/out for one event type on one channel. Only non-critical notifications honor it
/// (spec 14.1). eventType "*" = every non-critical event. Absent row = the tenant default (enabled).
model NotificationPreference {
  id        String              @id @default(cuid())
  tenantId  String
  userId    String
  eventType String
  channel   NotificationChannel
  enabled   Boolean             @default(true)
  updatedAt DateTime            @updatedAt @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([id, tenantId])
  @@unique([tenantId, userId, eventType, channel])
}

/// Job-category permission (spec 10.1): an employee may take jobs of ONE job type or ONE category
/// (exactly one of jobTypeId / category, CHECK). Time-bounded and granted by a user. The
/// qualification engine requires a matching active row (it defines how "no rows at all" is treated).
model EmployeeJobPermission {
  id            String    @id @default(cuid())
  tenantId      String
  employeeId    String
  jobTypeId     String?
  /// Matches JobType.category (case-sensitive, tenant-defined).
  category      String?
  effectiveFrom DateTime  @default(now()) @db.Timestamptz(3)
  effectiveTo   DateTime? @db.Timestamptz(3)
  grantedById   String?
  reason        String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee  Employee @relation(fields: [employeeId, tenantId], references: [id, tenantId], onDelete: Restrict)
  jobType   JobType? @relation(fields: [jobTypeId, tenantId], references: [id, tenantId], onDelete: Restrict)
  grantedBy User?    @relation("JobPermissionGrantedBy", fields: [grantedById, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@index([tenantId, employeeId, effectiveTo])
  @@index([tenantId, jobTypeId])
  @@index([tenantId, category])
}

/// A customer's employee preference (spec 7.3 soft factor "customer preference"): PREFERRED ranks
/// that employee higher, AVOID lower (never an eligibility rule). Real FKs, not ids inside JSON.
model CustomerPreferredEmployee {
  id         String                     @id @default(cuid())
  tenantId   String
  customerId String
  employeeId String
  kind       CustomerEmployeePreference @default(PREFERRED)
  note       String?
  createdAt  DateTime                   @default(now()) @db.Timestamptz(3)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer Customer @relation(fields: [customerId, tenantId], references: [id, tenantId], onDelete: Restrict)
  employee Employee @relation(fields: [employeeId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@unique([tenantId, customerId, employeeId])
  @@index([tenantId, employeeId])
}

// ═════════════════════════ Phase 3: field operations and recovery ═════════════════════════
// Every table below is tenant-owned (tenantId, @@unique([id, tenantId]), composite FKs, FORCE RLS).
// JSON columns hold ids, codes, numbers and enum values only (see docs/ERD.md "Contracts for JSON");
// the single documented exception is JobCompletion.values (the technician's form answers).
// Location data is sensitive (spec 22.2): raw coordinates live ONLY on LocationEvent; arrival
// verifications and recovery cases hold distances, accuracy, ids and status.

enum ShiftStatus {
  ACTIVE
  ENDED
}

/// Why a location could not be captured or accepted normally (spec 17.4).
enum LocationException {
  GPS_DISABLED
  PERMISSION_DENIED
  POOR_SIGNAL
  DEVICE_OFFLINE
  OUTSIDE_GEOFENCE
  DELAYED
  OTHER
}

/// Event-based collection only (spec 17.1). NAVIGATION_OPENED is informational: it never changes a
/// job status and never counts as arrival (spec 8.3).
enum LocationEventKind {
  SHIFT_START
  SHIFT_END
  ARRIVAL
  DEPARTURE
  NAVIGATION_OPENED
  VERIFICATION
}

enum LocationSource {
  DEVICE_GPS
  GEOFENCE
  MANUAL
  MANAGER
}

/// What the server concluded about the reported position. GPS is never "proof" (spec 17.2).
enum LocationVerification {
  UNVERIFIED
  WITHIN_RADIUS
  OUTSIDE_RADIUS
  MANAGER_VERIFIED
}

/// Review of a shift started or ended under an exception (shifts.approve).
enum ShiftExceptionReview {
  PENDING
  APPROVED
  REJECTED
}

enum ArrivalMethod {
  TECHNICIAN
  GEOFENCE
  MANAGER
}

enum ArrivalStatus {
  RECORDED
  PENDING_MANAGER_REVIEW
  MANAGER_VERIFIED
  MANAGER_REJECTED
}

enum FieldEventResult {
  ACCEPTED
  REJECTED
  CONFLICT
}

enum FormDefinitionStatus {
  DRAFT
  ACTIVE
  RETIRED
}

/// Spec 9.1 primary choices.
enum JobOutcomeType {
  SOLD
  NOT_SOLD
  CUSTOMER_UNAVAILABLE
  RESCHEDULE_REQUIRED
  WORK_NOT_POSSIBLE
  ADDITIONAL_APPROVAL_REQUIRED
}

enum PaymentMethod {
  CASH
  CARD
  CHECK
  BANK_TRANSFER
  FINANCING
  OTHER
}

enum PaymentStatus {
  NOT_APPLICABLE
  PENDING
  PARTIAL
  PAID
  WAIVED
  REFUSED
}

enum FieldNoteKind {
  NOTE
  WORK_PERFORMED
  ADDITIONAL_WORK_REQUESTED
  CUSTOMER_APPROVAL
}

enum AttachmentKind {
  PHOTO
  SIGNATURE
  DOCUMENT
}

/// No storage provider is configured in Phase 3: rows stay PENDING_UPLOAD (metadata captured on the
/// device) and are never marked STORED without a storage key.
enum AttachmentStatus {
  PENDING_UPLOAD
  STORED
  FAILED
}

enum RuleStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  INACTIVE
  SUPERSEDED
}

/// Spec 9.5.
enum RecoveryStatus {
  NEW
  ASSIGNED
  CONTACTING
  CUSTOMER_REACHED
  FOLLOW_UP_REQUIRED
  RECOVERED
  NOT_RECOVERED
  CLOSED
}

/// UNKNOWN whenever there is no valid, recent, accurate location (spec 26.5).
enum PresenceStatus {
  AT_LOCATION
  LEFT_LOCATION
  UNKNOWN
}

enum FollowUpTargetType {
  LEAD
  CUSTOMER
  JOB
  RECOVERY_CASE
}

enum FollowUpStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum FollowUpOrigin {
  MANUAL
  OUTCOME
  RECOVERY_RULE
  SYSTEM
}

// ───────────────────────── Shifts and location (spec 8.1, 17) ─────────────────────────

/// A technician's working shift (spec 8.1). At most one ACTIVE shift per employee (partial unique
/// index), so starting twice is idempotent. `startedAt` / `endedAt` are when it happened (device
/// clock for offline events); `*RecordedAt` is the server clock.
model Shift {
  id                    String                @id @default(cuid())
  tenantId              String
  employeeId            String
  /// The employee's placement when the shift started (snapshot): drives ORG_UNIT scope for managers.
  orgUnitId             String?
  status                ShiftStatus           @default(ACTIVE)
  startedAt             DateTime              @db.Timestamptz(3)
  startRecordedAt       DateTime              @default(now()) @db.Timestamptz(3)
  endedAt               DateTime?             @db.Timestamptz(3)
  endRecordedAt         DateTime?             @db.Timestamptz(3)
  deviceId              String?
  startLocationEventId  String?
  endLocationEventId    String?
  /// Exceptions: GPS disabled, permission denied, offline -> manual start/end with a note (spec 8.1, 17.4).
  startException        LocationException?
  startExceptionNote    String?
  endException          LocationException?
  endExceptionNote      String?
  /// Set when someone other than the technician ended or corrected the shift.
  endedByUserId         String?
  endReason             String?
  /// Review of the start/end exception (null = no exception). PENDING until someone with shifts.approve decides.
  exceptionReviewStatus ShiftExceptionReview?
  reviewedById          String?
  reviewedAt            DateTime?             @db.Timestamptz(3)
  reviewNote            String?
  createdAt             DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime              @updatedAt @db.Timestamptz(3)

  tenant             Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee           Employee              @relation(fields: [employeeId, tenantId], references: [id, tenantId], onDelete: Restrict)
  orgUnit            OrgUnit?              @relation(fields: [orgUnitId, tenantId], references: [id, tenantId], onDelete: Restrict)
  startLocationEvent LocationEvent?        @relation("ShiftStartEvent", fields: [startLocationEventId, employeeId, tenantId], references: [id, employeeId, tenantId], onDelete: Restrict)
  endLocationEvent   LocationEvent?        @relation("ShiftEndEvent", fields: [endLocationEventId, employeeId, tenantId], references: [id, employeeId, tenantId], onDelete: Restrict)
  reviewedBy         User?                 @relation("ShiftReviewedBy", fields: [reviewedById, tenantId], references: [id, tenantId], onDelete: Restrict)
  endedBy            User?                 @relation("ShiftEndedBy", fields: [endedByUserId, tenantId], references: [id, tenantId], onDelete: Restrict)
  locationEvents     LocationEvent[]       @relation("ShiftLocationEvents")
  arrivals           ArrivalVerification[]
  fieldEvents        FieldEvent[]

  @@unique([id, tenantId])
  @@unique([id, employeeId, tenantId])
  @@index([tenantId, employeeId, startedAt])
  @@index([tenantId, status, startedAt])
  @@index([tenantId, orgUnitId, startedAt])
}

/// One captured (or failed-to-capture) position (spec 17). SENSITIVE: coordinates are the opt-in
/// `location.coordinate_fields` field set; retention is `OperationsSettings.locationRetentionDays`.
/// Coordinates may be absent when `exception` explains why (GPS off, permission denied, offline) or the
/// event is manual / manager-entered / NAVIGATION_OPENED. Whenever coordinates exist, so does `accuracyM`.
model LocationEvent {
  id                  String               @id @default(cuid())
  tenantId            String
  employeeId          String
  shiftId             String?
  jobId               String?
  orgUnitId           String?
  kind                LocationEventKind
  source              LocationSource
  verification        LocationVerification @default(UNVERIFIED)
  latitude            Decimal?             @db.Decimal(9, 6)
  longitude           Decimal?             @db.Decimal(9, 6)
  /// Horizontal accuracy radius in whole meters, as reported by the device (rounded up).
  accuracyM           Int?
  /// Straight-line distance to the job address and the radius it was judged against (arrival checks).
  distanceToJobM      Int?
  geofenceRadiusM     Int?
  /// Device clock (null for manual / manager entries) vs the server's receive time (spec 17.2).
  deviceTime          DateTime?            @db.Timestamptz(3)
  serverTime          DateTime             @default(now()) @db.Timestamptz(3)
  deviceId            String?
  exception           LocationException?
  exceptionNote       String?
  /// Retention (spec 22.2): the purge NULLs latitude/longitude and stamps this; the row (kind, times, accuracy, distance) stays
  /// because shifts, arrivals and recovery cases reference it.
  coordinatesPurgedAt DateTime?            @db.Timestamptz(3)
  /// Who entered it when source = MANAGER (or MANUAL on someone's behalf).
  recordedByUserId    String?
  fieldEventId        String?

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee   Employee    @relation(fields: [employeeId, tenantId], references: [id, tenantId], onDelete: Restrict)
  shift      Shift?      @relation("ShiftLocationEvents", fields: [shiftId, employeeId, tenantId], references: [id, employeeId, tenantId], onDelete: Restrict)
  job        Job?        @relation(fields: [jobId, tenantId], references: [id, tenantId], onDelete: Restrict)
  orgUnit    OrgUnit?    @relation(fields: [orgUnitId, tenantId], references: [id, tenantId], onDelete: Restrict)
  recordedBy User?       @relation("LocationEventRecordedBy", fields: [recordedByUserId, tenantId], references: [id, tenantId], onDelete: Restrict)
  fieldEvent FieldEvent? @relation("LocationEventFieldEvent", fields: [fieldEventId, tenantId], references: [id, tenantId], onDelete: Restrict)

  shiftStarts          Shift[]               @relation("ShiftStartEvent")
  shiftEnds            Shift[]               @relation("ShiftEndEvent")
  arrivalVerifications ArrivalVerification[]
  recoveryPresence     LeadRecoveryCase[]

  @@unique([id, tenantId])
  @@unique([id, employeeId, tenantId])
  @@unique([id, jobId, employeeId, tenantId])
  @@unique([tenantId, fieldEventId])
  @@index([tenantId, employeeId, serverTime])
  @@index([tenantId, jobId, kind, serverTime])
  @@index([tenantId, shiftId])
  @@index([tenantId, serverTime])
}

/// How and when a technician's arrival at a job was established (spec 8.4, 17.2): technician
/// confirmation, an authorized geofence event, or manager verification. Several rows per job are
/// normal (return visits, corrections); the latest non-rejected row is the arrival. Text shown to
/// users is always about confidence, never certainty.
model ArrivalVerification {
  id               String             @id @default(cuid())
  tenantId         String
  jobId            String
  employeeId       String
  shiftId          String?
  method           ArrivalMethod
  status           ArrivalStatus      @default(RECORDED)
  /// When the technician arrived (device clock for offline) vs when the server recorded it.
  arrivedAt        DateTime           @db.Timestamptz(3)
  recordedAt       DateTime           @default(now()) @db.Timestamptz(3)
  locationEventId  String?
  accuracyM        Int?
  distanceToJobM   Int?
  geofenceRadiusM  Int?
  /// Outside the geofence / GPS off / offline ...: needs manager verification (spec 17.4).
  exceptionReason  LocationException?
  exceptionNote    String?
  /// Manager decision (verify or reject) and the mandatory reason for it.
  verifiedByUserId String?
  verifiedAt       DateTime?          @db.Timestamptz(3)
  verificationNote String?
  fieldEventId     String?

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  job           Job            @relation(fields: [jobId, tenantId], references: [id, tenantId], onDelete: Restrict)
  employee      Employee       @relation(fields: [employeeId, tenantId], references: [id, tenantId], onDelete: Restrict)
  shift         Shift?         @relation(fields: [shiftId, employeeId, tenantId], references: [id, employeeId, tenantId], onDelete: Restrict)
  locationEvent LocationEvent? @relation(fields: [locationEventId, jobId, employeeId, tenantId], references: [id, jobId, employeeId, tenantId], onDelete: Restrict)
  fieldEvent    FieldEvent?    @relation(fields: [fieldEventId, tenantId], references: [id, tenantId], onDelete: Restrict)
  verifiedBy    User?          @relation("ArrivalVerifiedBy", fields: [verifiedByUserId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@index([tenantId, jobId, arrivedAt])
  @@index([tenantId, employeeId, arrivedAt])
  @@index([tenantId, status, arrivedAt])
}

// ───────────────────────── Offline-safe field events (spec 8.7, 25.3) ─────────────────────────

/// Ingestion log for events a technician's device sends (live or after being offline). The unique
/// key (tenantId, employeeId, clientEventId) makes every submission idempotent: a replay finds this
/// row and returns the stored result instead of applying the event twice. Rejected events are stored
/// too, so a replay answers identically. `payload` holds ids and enum values only; free text lives
/// in the domain tables (JobFieldNote, JobOutcome, ...) which the payload points at.
model FieldEvent {
  id            String           @id @default(cuid())
  tenantId      String
  employeeId    String
  actorUserId   String?
  /// Client-generated UUID (CHECK).
  clientEventId String
  /// Dotted lower-case key, e.g. "shift.start", "job.status", "job.note", "job.outcome" (CHECK).
  type          String
  jobId         String?
  shiftId       String?
  deviceId      String?
  /// Sync batch this event arrived in (client-generated), for per-batch result reporting.
  batchId       String?
  /// When it happened on the device vs when the server received it. Events are applied in occurredAt order.
  occurredAt    DateTime         @db.Timestamptz(3)
  receivedAt    DateTime         @default(now()) @db.Timestamptz(3)
  payload       Json?
  /// sha256 (hex) of the canonical event content: a replay with the same clientEventId but a different hash is a CONFLICT.
  payloadHash   String?
  result        FieldEventResult
  /// Stable machine code for REJECTED / CONFLICT (e.g. "job.invalid_transition").
  resultCode    String?
  /// What the event created or changed (polymorphic; resolve through tenant-scoped queries).
  entityType    String?
  entityId      String?

  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee       Employee              @relation(fields: [employeeId, tenantId], references: [id, tenantId], onDelete: Restrict)
  actor          User?                 @relation("FieldEventActor", fields: [actorUserId, tenantId], references: [id, tenantId], onDelete: Restrict)
  job            Job?                  @relation(fields: [jobId, tenantId], references: [id, tenantId], onDelete: Restrict)
  shift          Shift?                @relation(fields: [shiftId, employeeId, tenantId], references: [id, employeeId, tenantId], onDelete: Restrict)
  locationEvents LocationEvent[]       @relation("LocationEventFieldEvent")
  arrivals       ArrivalVerification[]

  @@unique([id, tenantId])
  @@unique([tenantId, employeeId, clientEventId])
  @@index([tenantId, employeeId, occurredAt])
  @@index([tenantId, jobId, occurredAt])
  @@index([tenantId, batchId])
}

// ───────────────────────── Job completion (spec 8.5, 8.6) ─────────────────────────

/// Versioned completion form for ONE job type or ONE job category (exactly one, CHECK; spec 8.6
/// "configurable by job category"; a type-level form wins over a category-level one). Only DRAFT
/// rows may change `schema` (trigger); publishing makes a version ACTIVE and retires the previous.
/// `schema` is `{ "fields": [ { key, type, required, ... } ] }` (see ERD "Contracts for JSON").
model JobCompletionFormDefinition {
  id            String               @id @default(cuid())
  tenantId      String
  jobTypeId     String?
  /// Matches JobType.category (tenant-defined).
  category      String?
  version       Int
  status        FormDefinitionStatus @default(DRAFT)
  name          String
  schema        Json
  publishedAt   DateTime?            @db.Timestamptz(3)
  publishedById String?
  createdById   String?
  createdAt     DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime             @updatedAt @db.Timestamptz(3)

  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  jobType     JobType?        @relation(fields: [jobTypeId, tenantId], references: [id, tenantId], onDelete: Restrict)
  publishedBy User?           @relation("FormDefinitionPublishedBy", fields: [publishedById, tenantId], references: [id, tenantId], onDelete: Restrict)
  createdBy   User?           @relation("FormDefinitionCreatedBy", fields: [createdById, tenantId], references: [id, tenantId], onDelete: Restrict)
  completions JobCompletion[]

  @@unique([id, tenantId])
  @@unique([id, version, tenantId])
  @@unique([tenantId, jobTypeId, version])
  @@unique([tenantId, category, version])
  @@index([tenantId, jobTypeId, status])
  @@index([tenantId, category, status])
}

/// One submitted completion form for one visit of a job: the answers (a snapshot) and the exact form
/// version they were validated against. `values` is the documented exception to the ids-only JSON rule:
/// it holds the technician's answers keyed by field key. Money is NOT in here (see JobOutcome).
model JobCompletion {
  id                    String   @id @default(cuid())
  tenantId              String
  jobId                 String
  /// 1 for the first visit; a job sent back to SCHEDULED gets visit 2, ...
  visitNumber           Int      @default(1)
  employeeId            String
  formDefinitionId      String
  formVersion           Int
  values                Json
  workPerformed         String?  @db.Text
  followUpRequired      Boolean  @default(false)
  signatureAttachmentId String?
  occurredAt            DateTime @default(now()) @db.Timestamptz(3)
  submittedAt           DateTime @default(now()) @db.Timestamptz(3)
  submittedById         String?
  clientEventId         String?

  tenant         Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  job            Job                         @relation(fields: [jobId, tenantId], references: [id, tenantId], onDelete: Restrict)
  employee       Employee                    @relation(fields: [employeeId, tenantId], references: [id, tenantId], onDelete: Restrict)
  formDefinition JobCompletionFormDefinition @relation(fields: [formDefinitionId, formVersion, tenantId], references: [id, version, tenantId], onDelete: Restrict)
  signature      JobAttachment?              @relation("CompletionSignature", fields: [signatureAttachmentId, jobId, tenantId], references: [id, jobId, tenantId], onDelete: Restrict)
  submittedBy    User?                       @relation("JobCompletionSubmittedBy", fields: [submittedById, tenantId], references: [id, tenantId], onDelete: Restrict)
  materials      JobMaterialUsage[]

  @@unique([id, tenantId])
  @@unique([id, jobId, tenantId])
  @@unique([tenantId, jobId, visitNumber])
  @@unique([tenantId, jobId, clientEventId])
  @@index([tenantId, employeeId, submittedAt])
  @@index([tenantId, formDefinitionId])
}

/// Material used on a visit. Free text until the Phase 4 materials catalog exists: `materialRef` is
/// a placeholder id for that catalog (no FK yet).
model JobMaterialUsage {
  id                String    @id @default(cuid())
  tenantId          String
  jobId             String
  completionId      String?
  employeeId        String?
  name              String
  materialRef       String?
  /// Phase 4: the catalog material and the cost version in force when the usage was costed. The three cost columns are a
  /// snapshot (all set or all null, CHECK) and never change once set (trigger), so a later cost change cannot rewrite a past job.
  materialId        String?
  costVersionId     String?
  unitCostMinor     BigInt?
  extendedCostMinor BigInt?
  costCurrency      String?   @db.Char(3)
  costedAt          DateTime? @db.Timestamptz(3)
  quantity          Decimal   @db.Decimal(12, 3)
  unit              String    @default("each")
  note              String?
  occurredAt        DateTime  @default(now()) @db.Timestamptz(3)
  recordedAt        DateTime  @default(now()) @db.Timestamptz(3)
  clientEventId     String?

  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  job           Job                  @relation(fields: [jobId, tenantId], references: [id, tenantId], onDelete: Restrict)
  completion    JobCompletion?       @relation(fields: [completionId, jobId, tenantId], references: [id, jobId, tenantId], onDelete: Restrict)
  employee      Employee?            @relation(fields: [employeeId, tenantId], references: [id, tenantId], onDelete: Restrict)
  material      Material?            @relation(fields: [materialId, tenantId], references: [id, tenantId], onDelete: Restrict)
  costVersion   MaterialCostVersion? @relation(fields: [costVersionId, materialId, tenantId], references: [id, materialId, tenantId], onDelete: Restrict)
  ledgerEntries LedgerEntry[]

  @@unique([id, tenantId])
  @@unique([tenantId, jobId, clientEventId])
  @@index([tenantId, jobId, occurredAt])
  @@index([tenantId, completionId])
  @@index([tenantId, materialId])
}

/// Notes the technician records during work (spec 8.5): plain notes, work performed, additional work
/// requested and the customer's approval of it. Free text lives here, never in event payloads.
model JobFieldNote {
  id               String        @id @default(cuid())
  tenantId         String
  jobId            String
  employeeId       String?
  kind             FieldNoteKind @default(NOTE)
  body             String        @db.Text
  /// ADDITIONAL_WORK_REQUESTED: the estimate; CUSTOMER_APPROVAL: the approved amount (minor units).
  amountMinor      BigInt?
  currency         String        @default("USD") @db.Char(3)
  /// CUSTOMER_APPROVAL only: whether the customer approved (false = declined).
  customerApproved Boolean?
  occurredAt       DateTime      @default(now()) @db.Timestamptz(3)
  recordedAt       DateTime      @default(now()) @db.Timestamptz(3)
  clientEventId    String?

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  job      Job       @relation(fields: [jobId, tenantId], references: [id, tenantId], onDelete: Restrict)
  employee Employee? @relation(fields: [employeeId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@unique([tenantId, jobId, clientEventId])
  @@index([tenantId, jobId, occurredAt])
  @@index([tenantId, kind, occurredAt])
}

/// Photo / signature / document METADATA (spec 8.5). No storage provider exists in Phase 3: rows are
/// PENDING_UPLOAD and `storageKey` stays null; STORED requires a key (CHECK).
model JobAttachment {
  id              String           @id @default(cuid())
  tenantId        String
  jobId           String
  kind            AttachmentKind   @default(PHOTO)
  status          AttachmentStatus @default(PENDING_UPLOAD)
  fileName        String
  contentType     String
  sizeBytes       Int
  checksumSha256  String?
  caption         String?
  storageProvider String?
  storageKey      String?
  capturedAt      DateTime         @default(now()) @db.Timestamptz(3)
  recordedAt      DateTime         @default(now()) @db.Timestamptz(3)
  uploadedById    String?
  clientEventId   String?

  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  job        Job             @relation(fields: [jobId, tenantId], references: [id, tenantId], onDelete: Restrict)
  uploadedBy User?           @relation("JobAttachmentUploadedBy", fields: [uploadedById, tenantId], references: [id, tenantId], onDelete: Restrict)
  signedFor  JobCompletion[] @relation("CompletionSignature")

  @@unique([id, tenantId])
  @@unique([id, jobId, tenantId])
  @@unique([tenantId, jobId, clientEventId])
  @@index([tenantId, jobId, capturedAt])
}

// ───────────────────────── Outcome reporting (spec 9.1, 9.2) ─────────────────────────

/// Tenant-configurable lost / unsuccessful-visit reasons (spec 9.2). `appliesTo` lists the outcomes
/// the reason may be chosen for. Deactivate, never delete (outcomes reference them).
model LostReason {
  id          String           @id @default(cuid())
  tenantId    String
  /// Stable lower-case key, unique per tenant (CHECK).
  code        String
  name        String
  description String?
  appliesTo   JobOutcomeType[] @default([NOT_SOLD, WORK_NOT_POSSIBLE])
  /// False for reasons recovery can do nothing about (e.g. work outside service capabilities).
  recoverable Boolean          @default(true)
  active      Boolean          @default(true)
  sortOrder   Int              @default(0)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  outcomes      JobOutcome[]
  recoveryCases LeadRecoveryCase[]

  @@unique([id, tenantId])
  @@unique([tenantId, code])
  @@index([tenantId, active, sortOrder])
}

/// What happened at a customer visit (spec 9.1). One row per visit; the job cannot close without one.
/// Amounts are integer minor units in `currency` (no commission math, Phase 4). NOT_SOLD and
/// WORK_NOT_POSSIBLE require a lost reason (CHECK).
model JobOutcome {
  id                        String         @id @default(cuid())
  tenantId                  String
  jobId                     String
  visitNumber               Int            @default(1)
  employeeId                String?
  outcome                   JobOutcomeType
  lostReasonId              String?
  notes                     String?        @db.Text
  quotedAmountMinor         BigInt?
  approvedAmountMinor       BigInt?
  chargedAmountMinor        BigInt?
  collectedAmountMinor      BigInt?
  currency                  String         @default("USD") @db.Char(3)
  paymentMethod             PaymentMethod?
  paymentStatus             PaymentStatus  @default(NOT_APPLICABLE)
  /// The technician says the customer asked to be contacted again (spec 9.4 "customer request").
  customerRequestedFollowUp Boolean        @default(false)
  preferredFollowUpAt       DateTime?      @db.Timestamptz(3)
  occurredAt                DateTime       @default(now()) @db.Timestamptz(3)
  recordedAt                DateTime       @default(now()) @db.Timestamptz(3)
  recordedById              String?
  clientEventId             String?

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  job           Job                @relation(fields: [jobId, tenantId], references: [id, tenantId], onDelete: Restrict)
  employee      Employee?          @relation(fields: [employeeId, tenantId], references: [id, tenantId], onDelete: Restrict)
  lostReason    LostReason?        @relation(fields: [lostReasonId, tenantId], references: [id, tenantId], onDelete: Restrict)
  recordedBy    User?              @relation("JobOutcomeRecordedBy", fields: [recordedById, tenantId], references: [id, tenantId], onDelete: Restrict)
  recoveryCases LeadRecoveryCase[]

  ruleRuns RecoveryRuleRun[]

  ledgerEntries LedgerEntry[]
  payments      Payment[]
  adjustments   Adjustment[]

  @@unique([id, tenantId])
  @@unique([id, jobId, tenantId])
  @@unique([tenantId, jobId, visitNumber])
  @@unique([tenantId, jobId, clientEventId])
  @@index([tenantId, outcome, occurredAt])
  @@index([tenantId, lostReasonId])
  @@index([tenantId, employeeId, occurredAt])
}

// ───────────────────────── Lead recovery (spec 9.3 - 9.7) ─────────────────────────

/// A recovery rule, versioned (spec 9.6). `ruleKey` is the stable identity; each edit is a new row
/// with version + 1 and the previous ACTIVE one becomes SUPERSEDED. `trigger` is a dotted event key
/// (e.g. "job.not_converted"). `conditions` and `actions` are ids / codes / numbers only (see ERD
/// "Contracts for JSON"); an action can recommend a call or create a task, never offer a discount.
/// A highImpact rule can be ACTIVE only after approval by someone other than its author (CHECK, SoD).
model RecoveryRule {
  id              String     @id @default(cuid())
  tenantId        String
  ruleKey         String
  version         Int        @default(1)
  name            String
  description     String?
  status          RuleStatus @default(DRAFT)
  /// Lower number = evaluated first.
  priority        Int        @default(100)
  trigger         String
  conditions      Json
  actions         Json
  /// Scope: the org unit the rule applies to (and below); null = the whole tenant.
  orgUnitId       String?
  highImpact      Boolean    @default(false)
  /// Loop safety: the same rule does not fire again for the same job/customer within this window.
  cooldownMinutes Int        @default(0)
  createdById     String?
  submittedAt     DateTime?  @db.Timestamptz(3)
  approvedById    String?
  approvedAt      DateTime?  @db.Timestamptz(3)
  activatedAt     DateTime?  @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @db.Timestamptz(3)

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  orgUnit    OrgUnit?           @relation(fields: [orgUnitId, tenantId], references: [id, tenantId], onDelete: Restrict)
  createdBy  User?              @relation("RecoveryRuleCreatedBy", fields: [createdById, tenantId], references: [id, tenantId], onDelete: Restrict)
  approvedBy User?              @relation("RecoveryRuleApprovedBy", fields: [approvedById, tenantId], references: [id, tenantId], onDelete: Restrict)
  cases      LeadRecoveryCase[]
  runs       RecoveryRuleRun[]

  @@unique([id, tenantId])
  @@unique([id, version, tenantId])
  @@unique([tenantId, ruleKey, version])
  @@index([tenantId, status, trigger, priority])
  @@index([tenantId, orgUnitId])
}

/// A lead recovery case (spec 9.3 - 9.5) created from a not-converted job outcome (one case per
/// outcome: unique jobOutcomeId, so creation is idempotent). `presence*` is a SNAPSHOT of the
/// technician's presence when the case was evaluated: AT_LOCATION / LEFT_LOCATION only when backed by
/// a valid, recent, accurate LocationEvent (spec 26.5), else UNKNOWN. Estimates and confirmed revenue
/// are separate columns (spec 9.7): `estimatedValueMinor` is a guess, `recoveredAmountMinor` /
/// `collectedAmountMinor` are confirmed facts and need `recoveredAt` (CHECK).
model LeadRecoveryCase {
  id                      String         @id @default(cuid())
  tenantId                String
  /// Human-friendly number from NumberSequence "recovery_case".
  number                  Int
  jobOutcomeId            String
  jobId                   String
  customerId              String
  leadId                  String?
  technicianId            String?
  /// Service area of the job (scope).
  orgUnitId               String?
  lostReasonId            String?
  status                  RecoveryStatus @default(NEW)
  statusChangedAt         DateTime       @default(now()) @db.Timestamptz(3)
  priority                WorkPriority   @default(NORMAL)
  /// Rule-computed numeric priority input, explainable through the rule that created the case.
  priorityScore           Int?
  /// The recovery employee working the case.
  assignedToId            String?
  assignedAt              DateTime?      @db.Timestamptz(3)
  ruleId                  String?
  ruleVersion             Int?
  /// Machine code of the suggested next step, e.g. "call_customer". Never a discount (spec 9.6).
  recommendation          String?
  /// Job outcome time (spec 9.4).
  outcomeAt               DateTime       @db.Timestamptz(3)
  presenceStatus          PresenceStatus @default(UNKNOWN)
  presenceEvaluatedAt     DateTime?      @db.Timestamptz(3)
  /// The location event the presence was derived from; null when UNKNOWN.
  presenceLocationEventId String?
  presenceDistanceM       Int?
  presenceAccuracyM       Int?
  /// Machine code when UNKNOWN: "no_location", "stale_location", "inaccurate_location", "no_coordinates".
  presenceReason          String?
  initialValueMinor       BigInt?
  /// An estimate of what recovery could bring in; NEVER mixed into confirmed revenue.
  estimatedValueMinor     BigInt?
  currency                String         @default("USD") @db.Char(3)
  /// Confirmed result (spec 9.7), recorded together with `recoveredAt`.
  recoveredAt             DateTime?      @db.Timestamptz(3)
  recoveredAmountMinor    BigInt?
  collectedAmountMinor    BigInt?
  recoveredJobId          String?
  recoveredLeadId         String?
  recoveredById           String?
  attemptCount            Int            @default(0)
  lastAttemptAt           DateTime?      @db.Timestamptz(3)
  closedAt                DateTime?      @db.Timestamptz(3)
  closeReason             String?
  createdAt               DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime       @updatedAt @db.Timestamptz(3)

  tenant           Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  jobOutcome       JobOutcome                  @relation(fields: [jobOutcomeId, jobId, tenantId], references: [id, jobId, tenantId], onDelete: Restrict)
  job              Job                         @relation("RecoveryCaseJob", fields: [jobId, customerId, tenantId], references: [id, customerId, tenantId], onDelete: Restrict)
  customer         Customer                    @relation(fields: [customerId, tenantId], references: [id, tenantId], onDelete: Restrict)
  lead             Lead?                       @relation(fields: [leadId, customerId, tenantId], references: [id, customerId, tenantId], onDelete: Restrict)
  technician       Employee?                   @relation("RecoveryCaseTechnician", fields: [technicianId, tenantId], references: [id, tenantId], onDelete: Restrict)
  orgUnit          OrgUnit?                    @relation(fields: [orgUnitId, tenantId], references: [id, tenantId], onDelete: Restrict)
  lostReason       LostReason?                 @relation(fields: [lostReasonId, tenantId], references: [id, tenantId], onDelete: Restrict)
  assignedTo       Employee?                   @relation("RecoveryCaseAssignee", fields: [assignedToId, tenantId], references: [id, tenantId], onDelete: Restrict)
  rule             RecoveryRule?               @relation(fields: [ruleId, ruleVersion, tenantId], references: [id, version, tenantId], onDelete: Restrict)
  presenceLocation LocationEvent?              @relation(fields: [presenceLocationEventId, technicianId, tenantId], references: [id, employeeId, tenantId], onDelete: Restrict)
  recoveredLead    Lead?                       @relation("RecoveredLead", fields: [recoveredLeadId, customerId, tenantId], references: [id, customerId, tenantId], onDelete: Restrict)
  recoveredJob     Job?                        @relation("RecoveredJob", fields: [recoveredJobId, customerId, tenantId], references: [id, customerId, tenantId], onDelete: Restrict)
  recoveredBy      User?                       @relation("RecoveryCaseRecoveredBy", fields: [recoveredById, tenantId], references: [id, tenantId], onDelete: Restrict)
  attempts         RecoveryAttempt[]
  statusHistory    RecoveryCaseStatusHistory[]
  followUps        FollowUpTask[]
  ruleRuns         RecoveryRuleRun[]

  @@unique([id, tenantId])
  @@unique([tenantId, number])
  @@unique([tenantId, jobOutcomeId])
  @@index([tenantId, status, priority, outcomeAt])
  @@index([tenantId, orgUnitId, status])
  @@index([tenantId, assignedToId, status])
  @@index([tenantId, jobId])
  @@index([tenantId, customerId])
}

/// Append-only (trigger). One row per recovery status change (the first row has fromStatus null).
model RecoveryCaseStatusHistory {
  id          String          @id @default(cuid())
  tenantId    String
  caseId      String
  fromStatus  RecoveryStatus?
  toStatus    RecoveryStatus
  actorType   AuditActorType  @default(USER)
  actorUserId String?
  reason      String?
  occurredAt  DateTime        @default(now()) @db.Timestamptz(3)

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  case      LeadRecoveryCase @relation(fields: [caseId, tenantId], references: [id, tenantId], onDelete: Restrict)
  changedBy User?            @relation("RecoveryStatusChangedBy", fields: [actorUserId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@index([tenantId, caseId, occurredAt])
}

/// One communication attempt on a recovery case (spec 9.3 "record communication attempts"). Channel
/// and outcome reuse the lead-contact vocabularies. `offeredAmountMinor` records an amount the
/// employee quoted, if any; the platform itself never offers a discount (spec 9.6).
model RecoveryAttempt {
  id                 String          @id @default(cuid())
  tenantId           String
  caseId             String
  employeeId         String?
  channel            ContactChannel
  outcome            ContactOutcome?
  occurredAt         DateTime        @default(now()) @db.Timestamptz(3)
  durationSeconds    Int?
  notes              String?         @db.Text
  offeredAmountMinor BigInt?
  recordedAt         DateTime        @default(now()) @db.Timestamptz(3)
  recordedById       String?

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  case       LeadRecoveryCase @relation(fields: [caseId, tenantId], references: [id, tenantId], onDelete: Restrict)
  employee   Employee?        @relation("RecoveryAttemptEmployee", fields: [employeeId, tenantId], references: [id, tenantId], onDelete: Restrict)
  recordedBy User?            @relation("RecoveryAttemptRecordedBy", fields: [recordedById, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@index([tenantId, caseId, occurredAt])
  @@index([tenantId, employeeId, occurredAt])
}

// ───────────────────────── Follow-up tasks (spec 5.6, 5.9, 9.3) ─────────────────────────

/// A generic follow-up task. The target is typed: `targetType` says which ONE of leadId / customerId /
/// jobId / recoveryCaseId is set (CHECK), so every target is a tenant-safe composite FK. `dedupeKey`
/// lets a rule or sweep create "the same task" idempotently. The sweep stamps `dueSoonNotifiedAt` /
/// `overdueNotifiedAt` so each notification is sent once.
model FollowUpTask {
  id                String             @id @default(cuid())
  tenantId          String
  targetType        FollowUpTargetType
  leadId            String?
  customerId        String?
  jobId             String?
  recoveryCaseId    String?
  orgUnitId         String?
  title             String
  description       String?            @db.Text
  status            FollowUpStatus     @default(OPEN)
  priority          WorkPriority       @default(NORMAL)
  origin            FollowUpOrigin     @default(MANUAL)
  assigneeId        String?
  assignedAt        DateTime?          @db.Timestamptz(3)
  dueAt             DateTime           @db.Timestamptz(3)
  dedupeKey         String?
  dueSoonNotifiedAt DateTime?          @db.Timestamptz(3)
  overdueNotifiedAt DateTime?          @db.Timestamptz(3)
  completedAt       DateTime?          @db.Timestamptz(3)
  completedById     String?
  completionNote    String?
  cancelledAt       DateTime?          @db.Timestamptz(3)
  cancelReason      String?
  createdById       String?
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(3)

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  lead         Lead?             @relation(fields: [leadId, tenantId], references: [id, tenantId], onDelete: Restrict)
  customer     Customer?         @relation(fields: [customerId, tenantId], references: [id, tenantId], onDelete: Restrict)
  job          Job?              @relation(fields: [jobId, tenantId], references: [id, tenantId], onDelete: Restrict)
  recoveryCase LeadRecoveryCase? @relation(fields: [recoveryCaseId, tenantId], references: [id, tenantId], onDelete: Restrict)
  orgUnit      OrgUnit?          @relation(fields: [orgUnitId, tenantId], references: [id, tenantId], onDelete: Restrict)
  assignee     Employee?         @relation("FollowUpAssignee", fields: [assigneeId, tenantId], references: [id, tenantId], onDelete: Restrict)
  completedBy  User?             @relation("FollowUpCompletedBy", fields: [completedById, tenantId], references: [id, tenantId], onDelete: Restrict)
  createdBy    User?             @relation("FollowUpCreatedBy", fields: [createdById, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@unique([tenantId, dedupeKey])
  @@index([tenantId, status, dueAt])
  @@index([tenantId, assigneeId, status, dueAt])
  @@index([tenantId, orgUnitId, status])
  @@index([tenantId, targetType, status])
  @@index([tenantId, leadId])
  @@index([tenantId, customerId])
  @@index([tenantId, jobId])
  @@index([tenantId, recoveryCaseId])
}

/// One evaluation of one rule version for one job outcome (spec 9.6; explainability, cooldown and loop safety). Append-only
/// (trigger). `(tenantId, ruleId, jobOutcomeId)` is unique, so re-running the engine for an outcome never fires a rule twice.
/// Cooldown = look up the latest run of the rule for the same customer inside `cooldownMinutes`. `actionsTaken` is an array of
/// action codes ("create_case", "notify", "create_follow_up", "recommend"); `skippedReason` is a machine code ("cooldown",
/// "conditions_not_met", "rule_inactive", ...) and, when set, `actionsTaken` is empty. Dry runs are NOT stored.
model RecoveryRuleRun {
  id             String   @id @default(cuid())
  tenantId       String
  ruleId         String
  ruleVersion    Int
  jobOutcomeId   String
  customerId     String
  matched        Boolean
  actionsTaken   Json     @default("[]")
  skippedReason  String?
  recoveryCaseId String?
  firedAt        DateTime @default(now()) @db.Timestamptz(3)

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  rule         RecoveryRule      @relation(fields: [ruleId, ruleVersion, tenantId], references: [id, version, tenantId], onDelete: Restrict)
  jobOutcome   JobOutcome        @relation(fields: [jobOutcomeId, tenantId], references: [id, tenantId], onDelete: Restrict)
  customer     Customer          @relation(fields: [customerId, tenantId], references: [id, tenantId], onDelete: Restrict)
  recoveryCase LeadRecoveryCase? @relation(fields: [recoveryCaseId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@unique([tenantId, ruleId, jobOutcomeId])
  @@index([tenantId, ruleId, customerId, firedAt])
  @@index([tenantId, jobOutcomeId])
}

// ═════════════════════════ Phase 4: financial core (spec Part 11, 21.3, 25.4, 26.4) ═════════════════════════
// Money = BigInt minor units + ISO currency, never floats. No compensation / commission tables: those wait for the
// owner's compensation specification (spec 28.4, docs/DECISIONS.md).

enum MaterialCostStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
}

enum LedgerEntryType {
  CHARGE
  PAYMENT
  REFUND
  CHARGEBACK
  ADJUSTMENT
  REVERSAL
  MATERIAL_COST
}

/// What produced the entry (spec 11.8): the record the posting refers to.
enum LedgerSource {
  JOB
  OUTCOME
  PAYMENT
  REFUND
  CHARGEBACK
  ADJUSTMENT
  MATERIAL_USAGE
  REVERSAL
}

enum PaymentRecordStatus {
  PENDING
  RECEIVED
  FAILED
  VOIDED
}

/// Who created a payment record: a person recording it, or the authenticated provider intake.
enum PaymentOrigin {
  MANUAL
  PROVIDER
}

enum RefundStatus {
  REQUESTED
  PENDING_APPROVAL
  APPROVED
  REJECTED
  POSTED
  CANCELLED
}

enum ChargebackStatus {
  OPEN
  DISPUTED
  WON
  LOST
  WRITE_OFF_PENDING_APPROVAL
  WRITTEN_OFF
}

enum AdjustmentStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  POSTED
  CANCELLED
}

enum ApprovalSubjectType {
  MATERIAL_COST_CHANGE
  ADJUSTMENT
  REFUND
  CHARGEBACK_WRITE_OFF
  HIGH_VALUE_DISCOUNT
}

enum ApprovalRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
}

enum ApprovalDecisionKind {
  APPROVE
  REJECT
}

enum ReconciliationRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum ReconciliationExceptionKind {
  UNPAID
  PARTIAL_PAYMENT
  OVERPAYMENT
  FAILED_PAYMENT
  DUPLICATE_EXTERNAL_EVENT
  OUTCOME_LEDGER_MISMATCH
  REFUND_WITHOUT_PAYMENT
  UNMATCHED_PROVIDER_EVENT
  OTHER
}

enum ReconciliationExceptionStatus {
  OPEN
  ASSIGNED
  RESOLVED
}

/// What the authenticated intake did with an external payment event (spec 18.3, 26.4).
enum PaymentIntakeStatus {
  RECEIVED
  ACCEPTED
  REJECTED
  DUPLICATE
  UNMATCHED
}

/// A material in the tenant's catalog (spec 11.4). Its cost lives in MaterialCostVersion, never on this row.
model Material {
  id          String    @id @default(cuid())
  tenantId    String
  /// Stable lowercase code, unique per tenant (CHECK material_code_format).
  code        String
  name        String
  description String?   @db.Text
  unit        String    @default("each")
  supplier    String?
  active      Boolean   @default(true)
  archivedAt  DateTime? @db.Timestamptz(3)
  createdById String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdBy    User?                 @relation("MaterialCreatedBy", fields: [createdById, tenantId], references: [id, tenantId], onDelete: Restrict)
  costVersions MaterialCostVersion[]
  usages       JobMaterialUsage[]

  @@unique([id, tenantId])
  @@unique([tenantId, code])
  @@index([tenantId, active])
}

/// One cost of a material for a period (spec 11.4, 25.4). Once APPROVED the cost, currency, start and version number
/// never change (trigger material_cost_version_guard); a later cost is a new version that closes this one by setting
/// `effectiveTo`. Approved versions of one material never overlap (exclusion constraint). `approvalRequestId` is null
/// when no approval policy applied to the change.
model MaterialCostVersion {
  id                String             @id @default(cuid())
  tenantId          String
  materialId        String
  versionNumber     Int
  unitCostMinor     BigInt
  currency          String             @default("USD") @db.Char(3)
  effectiveFrom     DateTime           @db.Timestamptz(3)
  effectiveTo       DateTime?          @db.Timestamptz(3)
  status            MaterialCostStatus @default(PENDING_APPROVAL)
  approvalRequestId String?
  note              String?            @db.Text
  createdById       String?
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  approvedAt        DateTime?          @db.Timestamptz(3)

  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  material        Material           @relation(fields: [materialId, tenantId], references: [id, tenantId], onDelete: Restrict)
  approvalRequest ApprovalRequest?   @relation(fields: [approvalRequestId, tenantId], references: [id, tenantId], onDelete: Restrict)
  createdBy       User?              @relation("MaterialCostVersionCreatedBy", fields: [createdById, tenantId], references: [id, tenantId], onDelete: Restrict)
  usages          JobMaterialUsage[]

  @@unique([id, tenantId])
  @@unique([id, materialId, tenantId])
  @@unique([tenantId, materialId, versionNumber])
  @@index([tenantId, materialId, effectiveFrom])
  @@index([tenantId, status])
}

/// Append-only money ledger (spec 11.8). The database rejects UPDATE/DELETE/TRUNCATE; a correction is a REVERSAL entry
/// (`reversesEntryId`, amount = minus the original) or an ADJUSTMENT. Sign convention (CHECKs): CHARGE and PAYMENT are
/// positive, REFUND, CHARGEBACK and MATERIAL_COST are negative, ADJUSTMENT either sign, REVERSAL the opposite of the
/// reversed entry; zero is never valid. Balances are always derived from the entries.
model LedgerEntry {
  id              String          @id @default(cuid())
  tenantId        String
  type            LedgerEntryType
  source          LedgerSource
  amountMinor     BigInt
  currency        String          @db.Char(3)
  jobId           String?
  customerId      String?
  outcomeId       String?
  paymentId       String?
  refundId        String?
  chargebackId    String?
  adjustmentId    String?
  materialUsageId String?
  /// Snapshot at posting (an entry is immutable): the job's service-area unit and its legal entity.
  orgUnitId       String?
  legalEntityId   String?
  reversesEntryId String?
  /// Unique per tenant: re-posting the same business event is a no-op (spec 20.3, 26.4).
  idempotencyKey  String
  /// A person, or a machine actor such as "system:provider-intake"; exactly one is set (CHECK).
  actorUserId     String?
  systemActor     String?
  memo            String?         @db.Text
  occurredAt      DateTime        @db.Timestamptz(3)
  recordedAt      DateTime        @default(now()) @db.Timestamptz(3)

  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  job           Job?              @relation(fields: [jobId, tenantId], references: [id, tenantId], onDelete: Restrict)
  customer      Customer?         @relation(fields: [customerId, tenantId], references: [id, tenantId], onDelete: Restrict)
  outcome       JobOutcome?       @relation(fields: [outcomeId, tenantId], references: [id, tenantId], onDelete: Restrict)
  payment       Payment?          @relation(fields: [paymentId, tenantId], references: [id, tenantId], onDelete: Restrict)
  refund        Refund?           @relation(fields: [refundId, tenantId], references: [id, tenantId], onDelete: Restrict)
  chargeback    Chargeback?       @relation(fields: [chargebackId, tenantId], references: [id, tenantId], onDelete: Restrict)
  adjustment    Adjustment?       @relation(fields: [adjustmentId, tenantId], references: [id, tenantId], onDelete: Restrict)
  materialUsage JobMaterialUsage? @relation(fields: [materialUsageId, tenantId], references: [id, tenantId], onDelete: Restrict)
  orgUnit       OrgUnit?          @relation("LedgerEntryOrgUnit", fields: [orgUnitId, tenantId], references: [id, tenantId], onDelete: Restrict)
  legalEntity   LegalEntity?      @relation(fields: [legalEntityId, tenantId], references: [id, tenantId], onDelete: Restrict)
  reverses      LedgerEntry?      @relation("LedgerReversal", fields: [reversesEntryId, tenantId], references: [id, tenantId], onDelete: Restrict)
  reversedBy    LedgerEntry[]     @relation("LedgerReversal")
  actor         User?             @relation("LedgerEntryActor", fields: [actorUserId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, jobId, occurredAt])
  @@index([tenantId, customerId, occurredAt])
  @@index([tenantId, type, occurredAt])
  @@index([tenantId, orgUnitId, occurredAt])
  @@index([tenantId, legalEntityId, occurredAt])
  @@index([tenantId, paymentId])
  @@index([tenantId, outcomeId])
  @@index([tenantId, reversesEntryId])
}

/// A payment against a job (spec 11.1). The money itself is the PAYMENT ledger entry posted when status becomes RECEIVED.
/// Provider payments carry (provider, providerRef), unique per tenant, so a webhook can never post twice.
model Payment {
  id             String              @id @default(cuid())
  tenantId       String
  jobId          String
  customerId     String?
  outcomeId      String?
  method         PaymentMethod
  status         PaymentRecordStatus @default(PENDING)
  origin         PaymentOrigin       @default(MANUAL)
  amountMinor    BigInt
  currency       String              @default("USD") @db.Char(3)
  /// Check number, terminal slip, bank reference typed by whoever recorded it.
  reference      String?
  provider       String?
  providerRef    String?
  intakeEventId  String?
  orgUnitId      String?
  idempotencyKey String?
  receivedAt     DateTime?           @db.Timestamptz(3)
  failedAt       DateTime?           @db.Timestamptz(3)
  failureReason  String?
  voidedAt       DateTime?           @db.Timestamptz(3)
  voidReason     String?
  recordedById   String?
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(3)

  tenant        Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  job           Job                       @relation(fields: [jobId, tenantId], references: [id, tenantId], onDelete: Restrict)
  customer      Customer?                 @relation(fields: [customerId, tenantId], references: [id, tenantId], onDelete: Restrict)
  outcome       JobOutcome?               @relation(fields: [outcomeId, tenantId], references: [id, tenantId], onDelete: Restrict)
  intakeEvent   PaymentIntakeEvent?       @relation("PaymentIntake", fields: [intakeEventId, tenantId], references: [id, tenantId], onDelete: Restrict)
  orgUnit       OrgUnit?                  @relation("PaymentOrgUnit", fields: [orgUnitId, tenantId], references: [id, tenantId], onDelete: Restrict)
  recordedBy    User?                     @relation("PaymentRecordedBy", fields: [recordedById, tenantId], references: [id, tenantId], onDelete: Restrict)
  ledgerEntries LedgerEntry[]
  refunds       Refund[]
  chargebacks   Chargeback[]
  exceptions    ReconciliationException[]

  @@unique([id, tenantId])
  @@unique([id, jobId, tenantId])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, jobId, status])
  @@index([tenantId, status, receivedAt])
  @@index([tenantId, orgUnitId, createdAt])
}

/// Money returned to a customer (spec 11.7). Posted as a negative REFUND ledger entry; approval per policy.
model Refund {
  id                String       @id @default(cuid())
  tenantId          String
  jobId             String
  paymentId         String?
  customerId        String?
  amountMinor       BigInt
  currency          String       @default("USD") @db.Char(3)
  reason            String       @db.Text
  status            RefundStatus @default(REQUESTED)
  approvalRequestId String?
  orgUnitId         String?
  idempotencyKey    String?
  providerRef       String?
  requestedById     String?
  requestedAt       DateTime     @default(now()) @db.Timestamptz(3)
  postedAt          DateTime?    @db.Timestamptz(3)
  decidedAt         DateTime?    @db.Timestamptz(3)
  createdAt         DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @db.Timestamptz(3)

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  job             Job              @relation(fields: [jobId, tenantId], references: [id, tenantId], onDelete: Restrict)
  payment         Payment?         @relation(fields: [paymentId, tenantId], references: [id, tenantId], onDelete: Restrict)
  customer        Customer?        @relation(fields: [customerId, tenantId], references: [id, tenantId], onDelete: Restrict)
  approvalRequest ApprovalRequest? @relation("RefundApproval", fields: [approvalRequestId, tenantId], references: [id, tenantId], onDelete: Restrict)
  orgUnit         OrgUnit?         @relation("RefundOrgUnit", fields: [orgUnitId, tenantId], references: [id, tenantId], onDelete: Restrict)
  requestedBy     User?            @relation("RefundRequestedBy", fields: [requestedById, tenantId], references: [id, tenantId], onDelete: Restrict)
  ledgerEntries   LedgerEntry[]

  @@unique([id, tenantId])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, jobId, status])
  @@index([tenantId, status, requestedAt])
  @@index([tenantId, paymentId])
}

/// A card or bank dispute (spec 11.7): OPEN until won or lost; a lost one is a negative CHARGEBACK entry, a write-off
/// of an unrecoverable loss needs approval per policy.
model Chargeback {
  id                        String           @id @default(cuid())
  tenantId                  String
  jobId                     String
  paymentId                 String?
  customerId                String?
  amountMinor               BigInt
  currency                  String           @default("USD") @db.Char(3)
  status                    ChargebackStatus @default(OPEN)
  reasonCode                String?
  notes                     String?          @db.Text
  provider                  String?
  providerRef               String?
  intakeEventId             String?
  writeOffApprovalRequestId String?
  orgUnitId                 String?
  idempotencyKey            String?
  openedAt                  DateTime         @default(now()) @db.Timestamptz(3)
  resolvedAt                DateTime?        @db.Timestamptz(3)
  recordedById              String?
  createdAt                 DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime         @updatedAt @db.Timestamptz(3)

  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  job              Job                 @relation(fields: [jobId, tenantId], references: [id, tenantId], onDelete: Restrict)
  payment          Payment?            @relation(fields: [paymentId, tenantId], references: [id, tenantId], onDelete: Restrict)
  customer         Customer?           @relation(fields: [customerId, tenantId], references: [id, tenantId], onDelete: Restrict)
  intakeEvent      PaymentIntakeEvent? @relation("ChargebackIntake", fields: [intakeEventId, tenantId], references: [id, tenantId], onDelete: Restrict)
  writeOffApproval ApprovalRequest?    @relation("ChargebackWriteOffApproval", fields: [writeOffApprovalRequestId, tenantId], references: [id, tenantId], onDelete: Restrict)
  orgUnit          OrgUnit?            @relation("ChargebackOrgUnit", fields: [orgUnitId, tenantId], references: [id, tenantId], onDelete: Restrict)
  recordedBy       User?               @relation("ChargebackRecordedBy", fields: [recordedById, tenantId], references: [id, tenantId], onDelete: Restrict)
  ledgerEntries    LedgerEntry[]

  @@unique([id, tenantId])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, jobId, status])
  @@index([tenantId, status, openedAt])
  @@index([tenantId, paymentId])
}

/// A signed correction of a job's or customer's balance (spec 11.7, 25.4), e.g. after a job was reopened. Posted as an
/// ADJUSTMENT ledger entry; the original entries are never edited.
model Adjustment {
  id                String           @id @default(cuid())
  tenantId          String
  jobId             String?
  customerId        String?
  outcomeId         String?
  /// Positive increases what is owed / revenue, negative decreases it; never zero (CHECK).
  amountMinor       BigInt
  currency          String           @default("USD") @db.Char(3)
  reasonCode        String?
  reason            String           @db.Text
  status            AdjustmentStatus @default(PENDING_APPROVAL)
  approvalRequestId String?
  orgUnitId         String?
  idempotencyKey    String?
  requestedById     String?
  requestedAt       DateTime         @default(now()) @db.Timestamptz(3)
  decidedAt         DateTime?        @db.Timestamptz(3)
  postedAt          DateTime?        @db.Timestamptz(3)
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @db.Timestamptz(3)

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  job             Job?             @relation(fields: [jobId, tenantId], references: [id, tenantId], onDelete: Restrict)
  customer        Customer?        @relation(fields: [customerId, tenantId], references: [id, tenantId], onDelete: Restrict)
  outcome         JobOutcome?      @relation(fields: [outcomeId, tenantId], references: [id, tenantId], onDelete: Restrict)
  approvalRequest ApprovalRequest? @relation("AdjustmentApproval", fields: [approvalRequestId, tenantId], references: [id, tenantId], onDelete: Restrict)
  orgUnit         OrgUnit?         @relation("AdjustmentOrgUnit", fields: [orgUnitId, tenantId], references: [id, tenantId], onDelete: Restrict)
  requestedBy     User?            @relation("AdjustmentRequestedBy", fields: [requestedById, tenantId], references: [id, tenantId], onDelete: Restrict)
  ledgerEntries   LedgerEntry[]

  @@unique([id, tenantId])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, jobId, status])
  @@index([tenantId, status, requestedAt])
}

/// Which changes need approval and from whom (spec 21.3, 11.5). A policy row is immutable apart from `active` (trigger
/// approval_policy_guard): changing it creates version + 1 of the same `code` and deactivates the old one. A request
/// snapshots the policy it was resolved with, so later edits never change a pending request.
/// The policy applies to an amount in `currency` that is >= `minAmountMinor` and (when set) < `maxAmountMinor`;
/// amount-less subjects (MATERIAL_COST_CHANGE) use minAmountMinor = 0.
model ApprovalPolicy {
  id                 String              @id @default(cuid())
  tenantId           String
  /// Stable key of the policy across versions, e.g. "refund_over_500".
  code               String
  subjectType        ApprovalSubjectType
  name               String
  version            Int                 @default(1)
  active             Boolean             @default(true)
  currency           String              @default("USD") @db.Char(3)
  minAmountMinor     BigInt              @default(0)
  maxAmountMinor     BigInt?
  /// 1 = single approval, 2 = dual approval (two different people).
  requiredApprovals  Int                 @default(1)
  /// Permission key the approver must hold, e.g. "finance_refunds.approve".
  approverPermission String
  /// Request expires this many hours after creation; null = never.
  expiresAfterHours  Int?
  createdById        String?
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdBy User?             @relation("ApprovalPolicyCreatedBy", fields: [createdById, tenantId], references: [id, tenantId], onDelete: Restrict)
  requests  ApprovalRequest[]

  @@unique([id, tenantId])
  @@unique([tenantId, code, version])
  @@index([tenantId, subjectType, active])
}

/// One generic approval request (spec 21.3). `subjectId` points at the record being approved (material cost version,
/// refund, adjustment, ...); it is polymorphic, so it has no foreign key; the subject module owns the link. At most one
/// PENDING request exists per subject. People in `excludedApproverIds` (editors / submitters besides the requester) and
/// the requester can never decide it (separation of duties, enforced by approval_decision_guard).
model ApprovalRequest {
  id                  String                @id @default(cuid())
  tenantId            String
  subjectType         ApprovalSubjectType
  subjectId           String
  policyId            String
  policyCode          String
  policyVersion       Int
  requiredApprovals   Int
  approverPermission  String
  status              ApprovalRequestStatus @default(PENDING)
  amountMinor         BigInt?
  currency            String?               @db.Char(3)
  jobId               String?
  customerId          String?
  /// Scope of the subject, so the approver queue can be filtered by the approver's access scope.
  orgUnitId           String?
  reason              String?               @db.Text
  /// Ids and numbers only (no free text): what the approver is shown, snapshotted at request time.
  details             Json?
  idempotencyKey      String?
  requestedById       String?
  excludedApproverIds String[]              @default([])
  requestedAt         DateTime              @default(now()) @db.Timestamptz(3)
  expiresAt           DateTime?             @db.Timestamptz(3)
  decidedAt           DateTime?             @db.Timestamptz(3)
  cancelledAt         DateTime?             @db.Timestamptz(3)
  cancelledById       String?
  cancelReason        String?
  createdAt           DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime              @updatedAt @db.Timestamptz(3)

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  policy       ApprovalPolicy        @relation(fields: [policyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  job          Job?                  @relation(fields: [jobId, tenantId], references: [id, tenantId], onDelete: Restrict)
  customer     Customer?             @relation(fields: [customerId, tenantId], references: [id, tenantId], onDelete: Restrict)
  orgUnit      OrgUnit?              @relation("ApprovalRequestOrgUnit", fields: [orgUnitId, tenantId], references: [id, tenantId], onDelete: Restrict)
  requestedBy  User?                 @relation("ApprovalRequestRequestedBy", fields: [requestedById, tenantId], references: [id, tenantId], onDelete: Restrict)
  cancelledBy  User?                 @relation("ApprovalRequestCancelledBy", fields: [cancelledById, tenantId], references: [id, tenantId], onDelete: Restrict)
  decisions    ApprovalDecision[]
  costVersions MaterialCostVersion[]
  refunds      Refund[]              @relation("RefundApproval")
  adjustments  Adjustment[]          @relation("AdjustmentApproval")
  chargebacks  Chargeback[]          @relation("ChargebackWriteOffApproval")

  @@unique([id, tenantId])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, requestedAt])
  @@index([tenantId, subjectType, subjectId])
  @@index([tenantId, orgUnitId, status])
  @@index([tenantId, requestedById])
}

/// One person's decision on a request. Append-only (trigger), one per (request, decider); the request's status is
/// derived from the decisions by the approval service, in the same transaction.
model ApprovalDecision {
  id        String               @id @default(cuid())
  tenantId  String
  requestId String
  deciderId String
  decision  ApprovalDecisionKind
  comment   String?              @db.Text
  decidedAt DateTime             @default(now()) @db.Timestamptz(3)

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  request ApprovalRequest @relation(fields: [requestId, tenantId], references: [id, tenantId], onDelete: Restrict)
  decider User            @relation("ApprovalDecisionDecider", fields: [deciderId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@unique([tenantId, requestId, deciderId])
  @@index([tenantId, requestId, decidedAt])
  @@index([tenantId, deciderId, decidedAt])
}

/// One reconciliation of expected (charged) against recorded (paid) money for a period (spec 5.7, 25.4).
model ReconciliationRun {
  id             String                  @id @default(cuid())
  tenantId       String
  legalEntityId  String?
  currency       String                  @default("USD") @db.Char(3)
  periodStart    DateTime                @db.Timestamptz(3)
  periodEnd      DateTime                @db.Timestamptz(3)
  status         ReconciliationRunStatus @default(RUNNING)
  jobsExamined   Int                     @default(0)
  exceptionCount Int                     @default(0)
  expectedMinor  BigInt                  @default(0)
  recordedMinor  BigInt                  @default(0)
  startedById    String?
  startedAt      DateTime                @default(now()) @db.Timestamptz(3)
  completedAt    DateTime?               @db.Timestamptz(3)
  failureReason  String?

  tenant      Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  legalEntity LegalEntity?              @relation(fields: [legalEntityId, tenantId], references: [id, tenantId], onDelete: Restrict)
  startedBy   User?                     @relation("ReconciliationRunStartedBy", fields: [startedById, tenantId], references: [id, tenantId], onDelete: Restrict)
  exceptions  ReconciliationException[]

  @@unique([id, tenantId])
  @@index([tenantId, startedAt])
  @@index([tenantId, legalEntityId, periodStart])
}

/// Something a reconciliation run found that a person must look at. Resolved only with a reason (CHECK).
model ReconciliationException {
  id                  String                        @id @default(cuid())
  tenantId            String
  runId               String
  kind                ReconciliationExceptionKind
  status              ReconciliationExceptionStatus @default(OPEN)
  jobId               String?
  paymentId           String?
  intakeEventId       String?
  currency            String                        @default("USD") @db.Char(3)
  expectedAmountMinor BigInt?
  recordedAmountMinor BigInt?
  /// Ids and numbers only.
  details             Json?
  assignedToId        String?
  assignedAt          DateTime?                     @db.Timestamptz(3)
  resolvedAt          DateTime?                     @db.Timestamptz(3)
  resolvedById        String?
  resolutionReason    String?                       @db.Text
  createdAt           DateTime                      @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                      @updatedAt @db.Timestamptz(3)

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  run         ReconciliationRun   @relation(fields: [runId, tenantId], references: [id, tenantId], onDelete: Restrict)
  job         Job?                @relation(fields: [jobId, tenantId], references: [id, tenantId], onDelete: Restrict)
  payment     Payment?            @relation(fields: [paymentId, tenantId], references: [id, tenantId], onDelete: Restrict)
  intakeEvent PaymentIntakeEvent? @relation("ReconciliationIntake", fields: [intakeEventId, tenantId], references: [id, tenantId], onDelete: Restrict)
  assignedTo  User?               @relation("ReconciliationExceptionAssignedTo", fields: [assignedToId, tenantId], references: [id, tenantId], onDelete: Restrict)
  resolvedBy  User?               @relation("ReconciliationExceptionResolvedBy", fields: [resolvedById, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@index([tenantId, runId, status])
  @@index([tenantId, status, kind])
  @@index([tenantId, jobId])
}

/// Log of every external payment event the authenticated intake received (spec 18.3, 26.4). Written BEFORE any core
/// record is touched; (tenant, provider, externalId) is unique, so a repeated webhook finds its first row and never posts
/// twice. The raw payload is not stored (it may carry card or bank data): only its SHA-256 and the validated fields.
/// Identity columns never change after insert (trigger payment_intake_event_guard); outcome columns are set once.
model PaymentIntakeEvent {
  id             String              @id @default(cuid())
  tenantId       String
  provider       String
  externalId     String
  eventType      String
  /// SHA-256 of the raw body, lowercase hex (CHECK).
  payloadHash    String              @db.Char(64)
  signatureValid Boolean
  status         PaymentIntakeStatus @default(RECEIVED)
  /// Machine code when REJECTED / UNMATCHED / DUPLICATE, e.g. "bad_signature", "unknown_job", "currency_mismatch".
  rejectionCode  String?
  /// The validated, normalized fields (ids, amounts as strings, currency); never raw provider payload.
  parsed         Json?
  amountMinor    BigInt?
  currency       String?             @db.Char(3)
  jobId          String?
  paymentId      String?
  duplicateOfId  String?
  occurredAt     DateTime?           @db.Timestamptz(3)
  receivedAt     DateTime            @default(now()) @db.Timestamptz(3)
  processedAt    DateTime?           @db.Timestamptz(3)

  tenant      Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  job         Job?                      @relation(fields: [jobId, tenantId], references: [id, tenantId], onDelete: Restrict)
  payments    Payment[]                 @relation("PaymentIntake")
  chargebacks Chargeback[]              @relation("ChargebackIntake")
  exceptions  ReconciliationException[] @relation("ReconciliationIntake")

  @@unique([id, tenantId])
  @@unique([tenantId, provider, externalId])
  @@index([tenantId, status, receivedAt])
  @@index([tenantId, jobId])
}
