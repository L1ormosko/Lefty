# Copy to .env (never commit .env). App role is NOT a superuser and has NOBYPASSRLS.
DATABASE_URL="postgresql://leadro:leadro@127.0.0.1:5432/leadro"
# Used by the Vitest integration suite; must point at a throw-away database.
TEST_DATABASE_URL="postgresql://leadro:leadro@127.0.0.1:5432/leadro_test"

# AES-256-GCM key that encrypts MFA (TOTP) secrets at rest: 32 random bytes, base64.
# Generate one with:  openssl rand -base64 32
# MFA enrollment/verification refuse to run while this is missing or not 32 bytes. Losing or
# changing the key makes every enrolled authenticator unreadable (users must re-enroll).
LEADRO_ENCRYPTION_KEY=""
