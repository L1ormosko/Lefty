# PostgreSQL connection string
DATABASE_URL="postgresql://velto:velto@127.0.0.1:5432/velto?schema=public"

# Base URL of the app (used for absolute links in notifications)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# MapLibre style URL.
# Default (below) is a keyless raster style built from OpenStreetMap tiles - fine for
# development. For production use a commercial tile provider and put the key here.
# Example: https://api.maptiler.com/maps/streets/style.json?key=YOUR_KEY
NEXT_PUBLIC_MAP_STYLE_URL=""

# Password for the seeded demo accounts (admin@velto.dev and friends).
# There is NO default: the seed creates an ADMIN account and runs against
# whatever DATABASE_URL points at, so a built-in password would be a published
# admin login. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Minimum 24 characters; the seed refuses to run otherwise.
SEED_PASSWORD=""

# Set to exactly "1" to create demo data. Anything else skips the seed
# entirely - this is the switch to turn the demo off before real customers,
# rather than a code change.
SEED_DEMO="1"

# Legacy. Uploaded images are stored in the database, not on disk, so nothing
# at runtime reads this. It is only the input to the one-time migration
# `npx tsx prisma/backfill-image-blobs.ts`, which looks here for images that
# were written to disk before the change. Safe to delete once that has run.
UPLOAD_DIR="public/uploads"

# Optional. Parses the free-text campaign brief on /brief with a language
# model. Without it the page still works - a rule-based Hebrew parser handles
# the same field set - and the page says which one answered. The model never
# sees the inventory and never produces a result: it returns a filter, which is
# then validated against our own enums and the real city list. See DECISIONS.md 18.
ANTHROPIC_API_KEY=""
# Optional override; defaults to a small, fast model.
ANTHROPIC_MODEL=""

# Transactional email (Resend, https://resend.com). Without these two, the app
# still works, but notify() only writes in-app notifications - nobody is
# emailed about a new inquiry, a booking decision, or a password reset.
RESEND_API_KEY=""
EMAIL_FROM="VELTO <notifications@yourdomain.com>"
